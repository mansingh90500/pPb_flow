//=========================================================================================================================
void
RaghuV0Ana::LoopV0Vertices(const edm::Event& iEvent,
				   const edm::EventSetup& iSetup)
  
  
{
  using namespace edm;
  using namespace std;
    
  edm::Handle< reco::VertexCollection > vertices;
  iEvent.getByToken(vtxTags_, vertices);
  
  if(!vertices->size())
    {
      std::cout<<"Invalid or empty vertex collection!"<<std::endl;
      return;
    }
  
  reco::VertexCollection recoVertices = *vertices;
  
  sort(recoVertices.begin(), recoVertices.end(), [](const reco::Vertex &a, const reco::Vertex &b){
      return a.tracksSize() > b.tracksSize();
    });
  
  unsigned int primaryvtx = 0;
  for ( primaryvtx = 0; primaryvtx < recoVertices.size(); primaryvtx++ ) {
    if ( (!recoVertices[primaryvtx].isFake())
         && fabs(recoVertices[primaryvtx].z()) <= 25.
         && recoVertices[primaryvtx].position().Rho() <= 2.0
         && recoVertices[primaryvtx].tracksSize() >=2 ) break;
  }
  reco::Vertex const * pv = &recoVertices[primaryvtx];
  double zBestVtx_ = pv->z();
  if (zBestVtx_ < zminVtx_ || zBestVtx_ > zmaxVtx_ ) return;
  zBestVtx1_ = zBestVtx_;
  
  edm::ESHandle<TransientTrackBuilder> theB;
  iSetup.get<TransientTrackRecord>().get("TransientTrackBuilder",theB);
  
  edm::Handle< reco::VertexCompositeCandidateCollection > V0s;
  iEvent.getByToken(V0Src_, V0s);
  
  edm::Handle<int> pCent;
  iEvent.getByToken(dbCent_, pCent);
  cent = Float_t(*pCent);
  if(cent >= 160) return;

  hzvtx_->Fill(zBestVtx1_);  
  hbin_->Fill(cent);


  V0pt_vect.resize(0);
  V0eta_vect.resize(0);
  V0phi_vect.resize(0);
  V0id_vect.resize(0);
  V0mass_vect.resize(0);

  pdau_pt_vect.resize(0);
  pdau_eta_vect.resize(0);
  pdau_phi_vect.resize(0);
  pdau_chi2_vect.resize(0);

  ndau_pt_vect.resize(0);
  ndau_eta_vect.resize(0);
  ndau_phi_vect.resize(0);
  ndau_chi2_vect.resize(0);

  V0pt_vect_unmatch.resize(0);
  V0eta_vect_unmatch.resize(0);
  V0phi_vect_unmatch.resize(0);
  V0id_vect_unmatch.resize(0);
  V0mass_vect_unmatch.resize(0);

  pdau_pt_vect_unmatch.resize(0);
  pdau_eta_vect_unmatch.resize(0);
  pdau_phi_vect_unmatch.resize(0);
  pdau_chi2_vect_unmatch.resize(0);

  ndau_pt_vect_unmatch.resize(0);
  ndau_eta_vect_unmatch.resize(0);
  ndau_phi_vect_unmatch.resize(0);
  ndau_chi2_vect_unmatch.resize(0);




  reco::VertexCompositeCandidateCollection recV0 = *V0s;
  for ( reco::VertexCompositeCandidateCollection::const_iterator recoV0s = recV0.begin();
	recoV0s != recV0.end();
	++recoV0s)
    {
      
      V0id = recoV0s->pdgId();
      if (fabs(V0id) != 3122) continue;
      V0mass = recoV0s->mass();
      
      //Float_t pdgmass = 1.115683;
      //Float_t pdgmass = 0.497611;
      V0phi = recoV0s->phi();
      V0pt = recoV0s->pt();
      V0eta = recoV0s->eta();
      V0rapidity = recoV0s->rapidity();
      V0phi = recoV0s->phi();
      GlobalPoint displacementFromPV ( (pv->x() - recoV0s->vx()), (pv->y() - recoV0s->vy()), (pv->z() - recoV0s->vz()) ) ;
      V0lxyz = (displacementFromPV.mag());
      V0Chi2 = recoV0s->vertexChi2();
      
      //3d pointing angle
      V0cosThetaXYZ = -(displacementFromPV.x()*recoV0s->px() + displacementFromPV.y()*recoV0s->py() + displacementFromPV.z()*recoV0s->pz()) / ( displacementFromPV.mag()*sqrt(recoV0s->px()*recoV0s->px() + recoV0s->py()*recoV0s->py() + recoV0s->pz()*recoV0s->pz()) );
      
      
      SMatrixSym3D V0totalCov = pv->covariance() + recoV0s->vertexCovariance();
      
      SVector3 V0distVecXYZ(displacementFromPV.x(), displacementFromPV.y(), displacementFromPV.z());
      V0distMagXYZ = ROOT::Math::Mag(V0distVecXYZ);
      V0sigmaDistMagXYZ = sqrt(ROOT::Math::Similarity(V0totalCov, V0distVecXYZ)) / V0distMagXYZ;
      V0vtxDecaySigXYZ = V0distMagXYZ/V0sigmaDistMagXYZ;
      
      if ( V0pt > 8.5 || V0pt < 0.2 ) continue;
      if ( V0rapidity > 2.5 || V0rapidity < -2.5 ) continue;
      
      dca = -999.;
      double dauLongImpactSig1 = -999.;
      double dauTransImpactSig1 = -999.;
      double dauLongImpactSig2 = -999.;
      double dauTransImpactSig2 = -999.;
      
      TVector3 pV0vector(recoV0s->px(), recoV0s->py(), recoV0s->pz());
      
      //double alpha , qt ,v0masspiproton1,v0masspiproton2;
      double alpha , qt ,v0masspipi,v0massee;

      if ( recoV0s->numberOfDaughters() != 2 ) continue;
      auto bT0 = recoV0s->daughter(0)->bestTrack();
      auto bT1 = recoV0s->daughter(1)->bestTrack();
      if ( bT0 and bT1 ) {
	auto tt0 = theB->build(bT0).initialFreeState();
	auto tt1 = theB->build(bT1).initialFreeState();
	
	ClosestApproachInRPhi cApp;
	cApp.calculate(tt0, tt1);
	if (cApp.status()) {
	  dca = std::abs(cApp.distance());
	}
      }
      
      auto d1 = recoV0s->daughter(0)->get<reco::TrackRef>();
      auto d2 = recoV0s->daughter(1)->get<reco::TrackRef>();
      
      double xVtxError = pv->xError();
      double yVtxError = pv->yError();
      double zVtxError = pv->zError();
      
      math::XYZPoint bestvtx(pv->x(),pv->y(),pv->z());
      
      double dzvtx1 = d1->dz(bestvtx);
      double dxyvtx1 = d1->dxy(bestvtx);
      double dzerror1 = sqrt(d1->dzError()*d1->dzError()+zVtxError*zVtxError);
      double dxyerror1 = sqrt(d1->d0Error()*d1->d0Error()+xVtxError*yVtxError);
      
      dauLongImpactSig1 = fabs(dzvtx1/dzerror1);
      dauTransImpactSig1 = fabs(dxyvtx1/dxyerror1);
      
      double dzvtx2 = d2->dz(bestvtx);
      double dxyvtx2 = d2->dxy(bestvtx);
      double dzerror2 = sqrt(d2->dzError()*d2->dzError()+zVtxError*zVtxError);
      double dxyerror2 = sqrt(d2->d0Error()*d2->d0Error()+xVtxError*yVtxError);
      
      dauLongImpactSig2 = fabs(dzvtx2/dzerror2);
      dauTransImpactSig2 = fabs(dxyvtx2/dxyerror2);
      
      
      double daupx1 = d1->px();
      double daupy1 = d1->py();
      double daupz1 = d1->pz();
      double pd1 = d1->p();
      
      double daupx2 = d2->px();
      double daupy2 = d2->py();
      double daupz2 = d2->pz();
      double pd2 = d2->p();
      
      TVector3 dauvec1(daupx1,daupy1,daupz1);
      TVector3 dauvec2(daupx2,daupy2,daupz2);
      TVector3 dauvecsum(dauvec1+dauvec2);
      
      double P1l = (pV0vector.Dot(dauvec1))/pV0vector.Mag();
      double P2l = (pV0vector.Dot(dauvec2))/pV0vector.Mag();
      
      qt = ((dauvec1.Cross(dauvec2)).Mag())/pV0vector.Mag();
      alpha = (P1l - P2l)/(P1l+P2l);
      
      /*      
      v0masspiproton1 = sqrt((sqrt(0.93827*0.93827+pd1*pd1)+sqrt(0.13957*0.13957+pd2*pd2))*(sqrt(0.93827*0.93827+pd1*pd1)+sqrt (0.13957*0.13957+pd2*pd2))-dauvecsum.Mag2());
      v0masspiproton2 = sqrt((sqrt(0.13957*0.13957+pd1*pd1)+sqrt(0.93827*0.93827+pd2*pd2))*(sqrt(0.13957*0.13957+pd1*pd1)+sqrt (0.93827*0.93827+pd2*pd2))-dauvecsum.Mag2());

      if((v0masspiproton1>=(1.115683-mis_la_range_) && v0masspiproton1<=(1.115683+mis_la_range_)) || (v0masspiproton2>=(1.115683-mis_la_range_) && v0masspiproton2<=(1.115683+mis_la_range_)) ) continue;  
      */

      v0masspipi = sqrt((sqrt(0.13957*0.13957+pd1*pd1)+sqrt(0.13957*0.13957+pd2*pd2))*(sqrt(0.13957*0.13957+pd1*pd1)+sqrt(0.13957*0.13957+pd2*pd2))-dauvecsum.Mag2());
      v0massee = sqrt((sqrt(0.000511*0.000511+pd1*pd1)+sqrt(0.000511*0.000511+pd2*pd2))*(sqrt(0.000511*0.000511+pd1*pd1)+sqrt(0.000511*0.000511+pd2*pd2))-dauvecsum.Mag2());

      if((v0masspipi >= (0.497614-mis_ks_range_) && v0masspipi <= (0.497614+mis_ks_range_)) || v0massee <= mis_ph_range_ ) continue;


      hV0pT_before_->Fill(V0pt);
      
      if ( recoV0s->daughter(0)->charge() > 0 ) 
	{
	  auto trk = dynamic_cast<const reco::RecoChargedCandidate*>(recoV0s->daughter(0))->track();
          //pdau_chi2 = trk->chi2();
          //pdau_ndf = trk->ndof();
	  pdau_chi2 = trk-> normalizedChi2();
          pdau_pt = trk->pt();
          pdau_eta = trk->eta();
          pdau_phi = trk->phi();
	  pTrkNHit = trk->numberOfValidHits();	 
	  pTrkPtError = trk->ptError();
	  pTrkNPxLayer= trk->hitPattern().pixelLayersWithMeasurement();
	  pTrkDCASigXY = dauTransImpactSig1;
	  pTrkDCASigZ = dauLongImpactSig1;
	  
	}
      else
	{
	  auto trk = dynamic_cast<const reco::RecoChargedCandidate*>(recoV0s->daughter(0))->track();
          //ndau_chi2 = trk->chi2();
          //ndau_ndf = trk->ndof();
	  ndau_chi2 = trk-> normalizedChi2();
	  ndau_pt = trk->pt();                                                                    
	  ndau_eta = trk->eta();                        
	  ndau_phi = trk->phi();
	  nTrkNHit = trk->numberOfValidHits();
          nTrkPtError = trk->ptError();
          nTrkNPxLayer= trk->hitPattern().pixelLayersWithMeasurement();
          nTrkDCASigXY = dauTransImpactSig1;
          nTrkDCASigZ = dauLongImpactSig1;
	  
	}
      
      if ( recoV0s->daughter(1)->charge() > 0 )
	{
	  auto trk = dynamic_cast<const reco::RecoChargedCandidate*>(recoV0s->daughter(1))->track();
          //pdau_chi2 = trk->chi2();
          //pdau_ndf = trk->ndof();
	  pdau_chi2 = trk-> normalizedChi2();
	  pdau_pt = trk->pt();
          pdau_eta = trk->eta();
          pdau_phi = trk->phi();
	  pTrkNHit = trk->numberOfValidHits();
          pTrkPtError = trk->ptError();
          pTrkNPxLayer= trk->hitPattern().pixelLayersWithMeasurement();
          pTrkDCASigXY = dauTransImpactSig2;
          pTrkDCASigZ = dauLongImpactSig2;
	  
	}
      else
	{
	  auto trk = dynamic_cast<const reco::RecoChargedCandidate*>(recoV0s->daughter(1))->track();
          //ndau_chi2 = trk->chi2();
          //ndau_ndf = trk->ndof();
	  ndau_chi2 = trk-> normalizedChi2();
	  ndau_pt = trk->pt();
          ndau_eta = trk->eta();
          ndau_phi = trk->phi();
	  nTrkNHit = trk->numberOfValidHits();
          nTrkPtError = trk->ptError();
          nTrkNPxLayer= trk->hitPattern().pixelLayersWithMeasurement();
          nTrkDCASigXY = dauTransImpactSig2;
          nTrkDCASigZ = dauLongImpactSig2;
	  
	}
      
      double mva = reader->EvaluateMVA(TString ("BDT")+Kshort);
      
      if ( mva <= mvaCut_ ) continue;
      
      if ( V0pt > pTmax_ || V0pt < pTmin_ ) continue;
      if ( V0rapidity > Rapmax_ || V0rapidity < Rapmin_ ) continue;
      if ( V0eta > Etamax_ || V0eta < Etamin_ ) continue;
      if ( V0mass > Massmax_ || V0mass < Massmin_ ) continue;

      //std::cout<<"pdau_chi2 is = "<< pdau_chi2 << "    "<< "ndau_chi2 is = "<<ndau_chi2<<std::endl;
      //std::cout<<"pdau_ndf is = "<< pdau_ndf << "    "<< "ndau_ndf is = "<<ndau_ndf<<std::endl;
      hV0mass_wocut_->Fill(V0mass);
      hV0pT_->Fill(V0pt); 
      harmen_wcut_ ->Fill(alpha,qt);
      hV0phi_->Fill(V0phi);
      hV0eta_->Fill(V0eta);

      V0pt_vect_unmatch.push_back(V0pt);
      V0eta_vect_unmatch.push_back(V0eta);
      V0phi_vect_unmatch.push_back(V0phi);
      V0id_vect_unmatch.push_back(V0id);
      V0mass_vect_unmatch.push_back(V0mass);
      
      pdau_pt_vect_unmatch.push_back(pdau_pt);
      pdau_eta_vect_unmatch.push_back(pdau_eta);
      pdau_phi_vect_unmatch.push_back(pdau_phi);
      pdau_chi2_vect_unmatch.push_back(pdau_chi2);
      
      ndau_pt_vect_unmatch.push_back(ndau_pt);
      ndau_eta_vect_unmatch.push_back(ndau_eta);
      ndau_phi_vect_unmatch.push_back(ndau_phi);
      ndau_chi2_vect_unmatch.push_back(ndau_chi2);
      
      bool match = kFALSE;
      //bool match;
      edm::Handle< reco::GenParticleCollection > V0ss;
      iEvent.getByToken(tracks_,V0ss);
      for(reco::GenParticleCollection::const_iterator GenV0s = V0ss->begin();
          GenV0s != V0ss->end();
          ++GenV0s)
        {
          int V0id_gen = GenV0s->pdgId();
          if (fabs(V0id_gen) != 3122) continue;

          double V0eta_gen = GenV0s->eta();
          double V0pt_gen = GenV0s->pt();
          double V0phi_gen = GenV0s->phi();
          double V0rapidity_gen = GenV0s->rapidity();
	  
	  if ( V0pt_gen > pTmax_ || V0pt_gen < pTmin_ ) continue;
          if ( V0eta_gen > Etamax_ || V0eta_gen < Etamin_ ) continue;
          if ( V0rapidity_gen > Rapmax_ || V0rapidity_gen < Rapmin_ ) continue;
	  
          double delR = fabs(sqrt(pow(V0phi - V0phi_gen,2) + pow(V0eta-V0eta_gen,2)));
          double delpt_genpt = fabs((V0pt - V0pt_gen)/V0pt_gen);

	  hdelR_->Fill(delR);
	  hdelpt_->Fill(delpt_genpt);

	  if (delR < del_R_ && delpt_genpt < del_R_)
	    {
	      match = kTRUE;
	      break;
	    }
	  else  match = kFALSE;	    
	}
      
      if (match)
	{
	  hV0mass_match_->Fill(V0mass);
	  
	  V0pt_vect.push_back(V0pt);
	  V0eta_vect.push_back(V0eta);
	  V0phi_vect.push_back(V0phi);
	  V0id_vect.push_back(V0id);
	  V0mass_vect.push_back(V0mass);
	  
	  pdau_pt_vect.push_back(pdau_pt);
	  pdau_eta_vect.push_back(pdau_eta);
	  pdau_phi_vect.push_back(pdau_phi);
	  pdau_chi2_vect.push_back(pdau_chi2);
	  
	  ndau_pt_vect.push_back(ndau_pt);
	  ndau_eta_vect.push_back(ndau_eta);
	  ndau_phi_vect.push_back(ndau_phi);
	  ndau_chi2_vect.push_back(ndau_chi2);
	  
	}
      else 
	{
	  hV0mass_unmatch_->Fill(V0mass);
	  continue;
	}
      
    }
  
  //std::cout<<"matched particle  "<<V0pt_vect.size()<<std::endl;
  for (unsigned int ntrk_1_reco = 0; ntrk_1_reco < V0pt_vect_unmatch.size(); ntrk_1_reco++)
    {
      //bool is_dcut_reco = kFALSE;

      double pchi2_1_reco = pdau_chi2_vect_unmatch[ntrk_1_reco];
      double nchi2_1_reco = ndau_chi2_vect_unmatch[ntrk_1_reco];
