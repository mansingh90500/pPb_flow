  ndau_chi2_vect.clear();

  V0pt_vect_unmatch.clear();
  V0eta_vect_unmatch.clear();
  V0phi_vect_unmatch.clear();
  V0id_vect_unmatch.clear();
  V0mass_vect_unmatch.clear();

  pdau_pt_vect_unmatch.clear();
