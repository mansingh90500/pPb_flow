  LoopV0Vertices(iEvent, iSetup);
  //LoopV0Vertices(iEvent, iSetup,false);


  // ----- Fill and push evt containers -----                                                                                                    
  evt_->run   = iEvent.id().run();
  evt_->event = iEvent.id().event();
  evt_->zvtx  = zBestVtx1_;
  
  evtVec_.push_back(*evt_);
  
  // ----- Reset evt container -----                                                                                                             
  evt_->reset();
}  



