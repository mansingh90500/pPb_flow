// CMSSW include files
#include "FWCore/ServiceRegistry/interface/Service.h"
#include "CommonTools/UtilAlgos/interface/TFileService.h"
#include "DataFormats/CaloTowers/interface/CaloTowerCollection.h"
#include "FWCore/MessageLogger/interface/MessageLogger.h"
#include "DataFormats/RecoCandidate/interface/RecoChargedCandidate.h"
#include "DataFormats/PatCandidates/interface/PackedCandidate.h"
#include "TrackingTools/TransientTrack/interface/TransientTrack.h"
#include "TrackingTools/Records/interface/TransientTrackRecord.h"
#include "TrackingTools/TransientTrack/interface/TransientTrackBuilder.h"
#include "FWCore/Utilities/interface/typelookup.h"
#include "DataFormats/Math/interface/deltaR.h"

// user include files
#include "Analyzer/RaghuV0Ana/interface/RaghuV0Ana.h"
#define M_PI 3.14159265358979323846

// constructors and destructor
//
RaghuV0Ana::RaghuV0Ana(const edm::ParameterSet& iConfig) :

  //tracks
  //trackTags_(consumes<reco::TrackCollection>(iConfig.getParameter<edm::InputTag>("tracksSrc"))),
  // trackTags_(consumes<std::vector<pat::PackedCandidate>>(iConfig.getParameter<edm::InputTag>("tracksSrc"))),   //recent
  trackTags_(consumes< edm::View< pat::PackedCandidate> >(iConfig.getParameter<edm::InputTag>("tracksSrc"))),
  packedCandToken_(consumes<pat::PackedCandidateCollection>(iConfig.getParameter<edm::InputTag>("packedCandidates"))),
  pc2trackAssocToken_(consumes<edm::Association<reco::TrackCollection>>(iConfig.getParameter<edm::InputTag>("trackAssociation"))),

   //vertex
  //vtxTags_(consumes<reco::VertexCollection>(iConfig.getParameter<edm::InputTag>("vertexSrc"))),
  vtxTags_(consumes<std::vector<reco::Vertex>>(iConfig.getParameter<edm::InputTag>("vertexSrc"))),
  //V0
  V0Src_(consumes<reco::VertexCompositeCandidateCollection>(iConfig.getParameter<edm::InputTag>("V0Src"))),
  V0Src_lm_(consumes<reco::VertexCompositeCandidateCollection>(iConfig.getParameter<edm::InputTag>("V0Src_lm"))),
  dbCent_(consumes<int>(iConfig.getUntrackedParameter<edm::InputTag>("dbCent"))),  

  theBToken_(esConsumes<TransientTrackBuilder, TransientTrackRecord>(edm::ESInputTag("", "TransientTrackBuilder"))),  //recent

  //=========================================================================================================
  pTmin_trg_(iConfig.getUntrackedParameter< std::vector< double > >("pTminTrk_trg")),
  pTmax_trg_(iConfig.getUntrackedParameter< std::vector< double > >("pTmaxTrk_trg")),
  pTmin_ass_(iConfig.getUntrackedParameter< std::vector< double > >("pTminTrk_ass")),
  pTmax_ass_(iConfig.getUntrackedParameter< std::vector< double > >("pTmaxTrk_ass")),
  pTmin_trg_lm_(iConfig.getUntrackedParameter< double >("pTminTrk_trg_lm")),
  pTmax_trg_lm_(iConfig.getUntrackedParameter< double >("pTmaxTrk_trg_lm")),
  pTmin_ass_lm_(iConfig.getUntrackedParameter< double >("pTminTrk_ass_lm")),
  pTmax_ass_lm_(iConfig.getUntrackedParameter< double >("pTmaxTrk_ass_lm")),
  pTmin_trg_ks_(iConfig.getUntrackedParameter< double >("pTminTrk_trg_ks")),
  pTmax_trg_ks_(iConfig.getUntrackedParameter< double >("pTmaxTrk_trg_ks")),
  pTmin_ass_ks_(iConfig.getUntrackedParameter< double >("pTminTrk_ass_ks")),
  pTmax_ass_ks_(iConfig.getUntrackedParameter< double >("pTmaxTrk_ass_ks")),
  bkgFactor(iConfig.getUntrackedParameter<unsigned int>("bkgFactor")),
  zminVtx_(iConfig.getUntrackedParameter<double>("zminVtx")),
  zmaxVtx_(iConfig.getUntrackedParameter<double>("zmaxVtx")),
  //==========================================================================================================
  dauNhitsmin_(iConfig.getUntrackedParameter<int>("dauNhitsMin")),
  mis_ks_range_(iConfig.getUntrackedParameter<double>("mis_ks_range")),
  mis_la_range_(iConfig.getUntrackedParameter<double>("mis_la_range")), 
  mis_ph_range_(iConfig.getUntrackedParameter<double>("mis_ph_range")),
  dauPixelhitsmin_(iConfig.getUntrackedParameter<int>("dauPixelhitsMin")),
  
  pTmin_(iConfig.getUntrackedParameter<double>("ptMin")),
  pTmax_(iConfig.getUntrackedParameter<double>("ptMax")),
  pTmin_ch_(iConfig.getUntrackedParameter<double>("ptMin_ch")),
  pTmax_ch_(iConfig.getUntrackedParameter<double>("ptMax_ch")),
  Etamin_(iConfig.getUntrackedParameter<double>("EtaMin")),
  Etamax_(iConfig.getUntrackedParameter<double>("EtaMax")),
  Rapmin_(iConfig.getUntrackedParameter<double>("RapMin")),
  Rapmax_(iConfig.getUntrackedParameter<double>("RapMax")),
  Massmin_(iConfig.getUntrackedParameter<double>("MassMin")),
  Massmax_(iConfig.getUntrackedParameter<double>("MassMax")),
  Massmin_lm_(iConfig.getUntrackedParameter<double>("MassMin_lm")),
  Massmax_lm_(iConfig.getUntrackedParameter<double>("MassMax_lm")),
  Chi2max_(iConfig.getUntrackedParameter<double>("Chi2Max")),
  ThetaXYZmin_(iConfig.getUntrackedParameter<double>("ThetaXYZMin")),
  //ThetaXYZmax_(iConfig.getUntrackedParameter<double>("ThetaXYZMax",999.)),
  DecaySigXYZmin_(iConfig.getUntrackedParameter<double>("DecayXYZMin")),
  //DecaySigXYZmax_(iConfig.getUntrackedParameter<double>("DecayXYZMax",9999999.)),
  DCAmax_(iConfig.getUntrackedParameter<double>("DCAMax")),
  
  //dau_costheta_(iConfig.getUntrackedParameter<double>("dau_costheta")),
  //dau_delpt_(iConfig.getUntrackedParameter<double>("dau_delpt")),
  
  dau_etaphi_(iConfig.getUntrackedParameter<double>("dau_etaphi")),
  //mvaXML_(iConfig.getUntrackedParameter<edm::InputTag>("mvaXML")),//new
  //mvaCut_(iConfig.getUntrackedParameter<double>("mvaCut")),
  del_R_(iConfig.getUntrackedParameter<double>("del_R")),
  fname_(iConfig.getUntrackedParameter<edm::InputTag>("fname")),
  fnameV0_(iConfig.getUntrackedParameter<edm::InputTag>("fnameV0")),
  sigma2_lambda_minMass(iConfig.getUntrackedParameter< std::vector<double>>("sigma2_lambda_minMass")),
  sigma2_lambda_maxMass(iConfig.getUntrackedParameter< std::vector<double>>("sigma2_lambda_maxMass")),
  sigma2_kshort_minMass(iConfig.getUntrackedParameter< std::vector<double>>("sigma2_kshort_minMass")),
  sigma2_kshort_maxMass(iConfig.getUntrackedParameter< std::vector<double>>("sigma2_kshort_maxMass")),
  sigma3_lambda_minMass(iConfig.getUntrackedParameter< std::vector<double>>("sigma3_lambda_minMass")),
  sigma3_lambda_maxMass(iConfig.getUntrackedParameter< std::vector<double>>("sigma3_lambda_maxMass")),
  sigma3_kshort_minMass(iConfig.getUntrackedParameter< std::vector<double>>("sigma3_kshort_minMass")),
  sigma3_kshort_maxMass(iConfig.getUntrackedParameter< std::vector<double>>("sigma3_kshort_maxMass")),
  binTable(iConfig.getUntrackedParameter< std::vector<double>>("binTable")),
  npt_binedge(iConfig.getUntrackedParameter< std::vector<double>>("npt_binedge")),
  npt_binedge_lm(iConfig.getUntrackedParameter< std::vector<double>>("npt_binedge_lm")),
  ncentbin_binedge(iConfig.getUntrackedParameter< std::vector<double>>("ncentbin_binedge")),
  nmass_lm_binedge(iConfig.getUntrackedParameter< std::vector<double>>("nmass_lm_binedge")),
  nmass_ks_binedge(iConfig.getUntrackedParameter< std::vector<double>>("nmass_ks_binedge"))
{


  isMC_ = iConfig.getUntrackedParameter<bool>("isMC", false);
  if (isMC_) {
    tracks_ = consumes<reco::GenParticleCollection>(iConfig.getParameter<edm::InputTag>("tracks"));
  }
  evt_ = new DiHadronCorrelationEvt(pTmin_trg_.size(), pTmin_ass_.size());  
  usesResource("TFileService");
  TH1::SetDefaultSumw2();
  TH2::SetDefaultSumw2();
  TH3::SetDefaultSumw2();
    
    // Now do what ever initialization is needed
    //std::cout << "error2" << std::endl;
    edm::Service<TFileService> fs;

    //**************************For efficiency correction ******************************************************
    TString filename(fname_.label().c_str());
    TString filenameV0(fnameV0_.label().c_str());
    feff_ = 0x0;
    feff_V0 = 0x0;
    
    if(!filename.IsNull())
      {
	edm::FileInPath fip(Form("Analyzer/RaghuV0Ana/data/EFF/%s",filename.Data()));
	feff_ = new TFile(fip.fullPath().c_str(),"READ");
	
	hEff_3D = (TH3F*)feff_->Get("hEff_3D");
	hFak3D = (TH3F*)feff_->Get("hFak_3D");
	hSec_3D = (TH3F*)feff_->Get("hSec_3D");
	hMul_3D = (TH3F*)feff_->Get("hMul_3D");
	
	feff_->Close();
      }
    if(!filenameV0.IsNull())
      {
	edm::FileInPath fipV0(Form("Analyzer/RaghuV0Ana/data/EFF/%s",filenameV0.Data()));
	feff_V0 = new TFile(fipV0.fullPath().c_str(),"READ");
	
	hEff_3D_ks = (TH3D*)feff_V0->Get("hEff_3D_ks");
	hEff_3D_lm = (TH3D*)feff_V0->Get("hEff_3D_lm");
	
	feff_V0->Close();
      }
    
    
    // Histograms
    TFileDirectory fGlobalHist  = fs->mkdir("QA_plots");
    //KShort
    hV0pT_          = fGlobalHist.make<TH1D>("hV0pT", "", 85 , 0.0, 8.5);
    hV0pT_before_          = fGlobalHist.make<TH1D>("hV0pT_before", "", 85 , 0.0, 8.5);
    hzvtx_          = fGlobalHist.make<TH1D>("hzvtx", "", 400 , -20, 20);
    hV0eta_          = fGlobalHist.make<TH1D>("hV0eta", "", 60 , -2.4, 2.4);
    hV0phi_          = fGlobalHist.make<TH1D>("hV0phi", "", 60 , -TMath::Pi(),  TMath::Pi());
    hbin_            = fGlobalHist.make<TH1I>("hbin", "", 200 , 0, 200);
    hcent_bin        = fGlobalHist.make<TH1F>("hcent_bin distribution", "", 16, 0, 80);
    hchi2_            = fGlobalHist.make<TH1F>("hchi2", "", 100, 0., 1.);

    //lambda
    hV0pT_lm_          = fGlobalHist.make<TH1D>("hV0pT_lm", "", 85 , 0.0, 8.5);
    hV0pT_before_lm_          = fGlobalHist.make<TH1D>("hV0pT_before_lm", "", 85 , 0.0, 8.5);
    hV0eta_lm_          = fGlobalHist.make<TH1D>("hV0eta_lm", "", 60 , -2.4, 2.4);
    hV0phi_lm_          = fGlobalHist.make<TH1D>("hV0phi_lm", "", 60 , -TMath::Pi(),  TMath::Pi());
    hchi2_lm_            = fGlobalHist.make<TH1F>("hchi2_lm", "", 100, 0., 1.);

    double nBins_deta = 32;
    double nBins_dphi = 32;

    double etaW = (4.0*2.4)/nBins_deta;
    double phiW = (2.0*TMath::Pi())/nBins_dphi;
    
    double eta_upedge = (2.0*2.4)+(etaW/2.0);
    double eta_lowedge = -(2.0*2.4)-(etaW/2.0);
    
    double phi_upedge = ((3.0*TMath::Pi()) - phiW)/2.0;
    double phi_lowedge = -(TMath::Pi() - phiW)/2.0;
    
    TFileDirectory fV0Hist  = fs->mkdir("V0_plots");

    //hntrg_addbincontent_endjob      = fV0Hist.make<TH1D>("hntrg_sig", "", 3 , 0, 3);
    //hntrg_addbincontent_endjob_bkg = fV0Hist.make<TH1D>("hntrg_bkg", "", 3 , 0, 3);
    hpt_trigg_lm_endjob             = fV0Hist.make<TH1D>("hpt_trigg_lm_endjob", "", 85 , 0.0, 8.5);
    hpt_trigg_ks_endjob	      	    = fV0Hist.make<TH1D>("hpt_assoc_endjob",	"", 85 , 0.0, 8.5);
    
    //hsignal_c2_lm_vs_ch          = fV0Hist.make<TH2D>("hsignal_c2_lm_vs_ch", "hsignal_c2_lm_vs_ch", nBins_deta+1, eta_lowedge, eta_upedge, nBins_dphi-1, phi_lowedge, phi_upedge);
    //hsignal_c2_ks_vs_ch          = fV0Hist.make<TH2D>("hsignal_c2_ks_vs_ch", "hsignal_c2_ks_vs_ch", nBins_deta+1, eta_lowedge, eta_upedge, nBins_dphi-1, phi_lowedge, phi_upedge);
    //hmixing_c2_lm_vs_ch          = fV0Hist.make<TH2D>("hmixing_c2_lm_vs_ch", "hmixing_c2_lm_vs_ch", nBins_deta+1, eta_lowedge, eta_upedge, nBins_dphi-1, phi_lowedge, phi_upedge);
    //hmixing_c2_ks_vs_ch          = fV0Hist.make<TH2D>("hmixing_c2_ks_vs_ch", "hmixing_c2_ks_vs_ch", nBins_deta+1, eta_lowedge, eta_upedge, nBins_dphi-1, phi_lowedge, phi_upedge);    

    hV0mass_wocut_lm_          = fV0Hist.make<TH1D>("hV0mass_lm", "", 160 ,1.08, 1.16);
    hV0mass_wocut_             =fV0Hist.make<TH1D>("hV0mass_ks", "", 260, 0.43, 0.56);
    //hV0mass_unmatch_          = fV0Hist.make<TH1D>("hV0mass_unmatch", "", 160 ,1.08, 1.16);

    harmen_wcut_lm_         = fV0Hist.make<TH2D>("harmen_wcut_lm", "", 100 , -1.0,1.0,150,0,0.3 );
    harmen_wocut_lm_         = fV0Hist.make<TH2D>("harmen_wocut_lm", "", 100 , -1.0,1.0,150,0,0.3 );
    harmen_wcut_         = fV0Hist.make<TH2D>("harmen_wcut_ks", "", 100 , -1.0,1.0,150,0,0.3 );
    harmen_wocut_         = fV0Hist.make<TH2D>("harmen_wocut_ks", "", 100 , -1.0,1.0,150,0,0.3 );
    
    //npt_binedge = {0.2, 0.5, 0.8, 1.0, 1.4, 1.8, 2.2, 2.8, 3.6, 4.6, 6.0, 7.0, 8.5};
    //npt_binedge = {0.2, 0.5, 0.8, 1.0, 1.2, 1.4, 1.6, 1.8, 2.0, 2.2, 2.4, 2.6, 2.8, 3.0, 3.6, 4.6, 6.0, 7.0, 8.5, 12.0};
    //npt_binedge = {0.2, 0.5, 0.6, 0.7, 0.8, 0.9, 1.0, 1.1, 1.2, 1.3, 1.4, 1.5, 1.6, 1.7, 1.8, 1.9, 2.0, 2.2, 2.4, 2.6, 2.8, 3.0, 3.2, 3.4, 3.6, 3.8, 4.0, 4.5, 5.0, 5.5, 6.0, 6.5, 8.0, 12.0};
    //ncentbin_binedge = {0, 10, 20, 40, 60, 80, 100, 120, 140, 200};
    //ncentbin_binedge = {0, 200};
    
    nptbins = npt_binedge.size() - 1;
    nptbins_lm = npt_binedge_lm.size() - 1;
    ncentbins = ncentbin_binedge.size() - 1;
    nmassbins_lm = nmass_lm_binedge.size() - 1;
    nmassbins_ks = nmass_ks_binedge.size() - 1;
    
    hV0pTbin = fV0Hist.make<TH1D>("hV0pTbin", "", nptbins, &npt_binedge[0]);
    hV0pTbin_lm = fV0Hist.make<TH1D>("hV0pTbin_lm", "", nptbins_lm, &npt_binedge_lm[0]);
    hV0centbin = fV0Hist.make<TH1D>("hV0centbin", "", ncentbins, &ncentbin_binedge[0]);
    hV0massbin_lm = fV0Hist.make<TH1D>("hV0massbin_lm", "", nmassbins_lm, &nmass_lm_binedge[0]);
    hV0massbin_ks = fV0Hist.make<TH1D>("hV0massbin_ks", "", nmassbins_ks, &nmass_ks_binedge[0]);
    
    TFileDirectory lambdapTHist = fs->mkdir("Lambda_pT");
    lambda_pT.resize(ncentbins);
    for (unsigned int ict = 0; ict < ncentbins; ++ict) {
      lambda_pT[ict].resize(nptbins);
      for (unsigned int ipt = 0; ipt < nptbins_lm; ++ipt) {
	lambda_pT[ict][ipt] = lambdapTHist.make<TH1D>(Form("lambda_cent_%d_pT_%d",ict, ipt), Form("%1.1f < p_{T} < %1.1f GeV/c", npt_binedge_lm[ipt], npt_binedge_lm[ipt+1]), 160, 1.08, 1.16);
      }
    }

    
    TFileDirectory kshortpTHist = fs->mkdir("kshort_pT");
    kshort_pT.resize(ncentbins);
    for (unsigned int ict = 0; ict < ncentbins; ++ict) {
      kshort_pT[ict].resize(nptbins);
      for (unsigned int ipt = 0; ipt < nptbins; ++ipt) {
	kshort_pT[ict][ipt] = kshortpTHist.make<TH1D>(Form("kshort_cent_%d_pT_%d", ict, ipt), Form("%1.1f < p_{T} < %1.1f GeV/c", npt_binedge[ipt], npt_binedge[ipt+1]), 260, 0.43, 0.56);
	
      }
    }
    
    TFileDirectory ntrgHist = fs->mkdir("Ntrigg");
    //hevent_V0_CH.resize(ncentbins);
    hntrg_ch.resize(ncentbins);
    hntrg_obs_lm.resize(ncentbins);
    hntrg_obs_ks.resize(ncentbins);
    for (unsigned int ict = 0; ict < ncentbins; ++ict) {
      hntrg_obs_lm[ict].resize(nptbins_lm);
      hntrg_obs_ks[ict].resize(nptbins);
      
      for (unsigned int ipt = 0; ipt < nptbins_lm; ++ipt) {
	hntrg_obs_lm[ict][ipt].resize(nmassbins_lm);
	
	for (unsigned int imass = 0; imass < nmassbins_lm; ++imass) {
	  hntrg_obs_lm[ict][ipt][imass] = ntrgHist.make<TH1D>(Form("hntrg_obs_lm_cent_%d_pT_%d_mass_%d", ict, ipt, imass), Form("%1.1f < p_{T} < %1.1f GeV/c & mass bin %d", npt_binedge_lm[ipt], npt_binedge_lm[ipt+1], imass), 2 ,0., 2.);
	} //end of lm mass bin
      }
	for (unsigned int ipt = 0; ipt < nptbins; ++ipt) {
	  hntrg_obs_ks[ict][ipt].resize(nmassbins_ks);
	  
	  for (unsigned int imass = 0; imass < nmassbins_ks; ++imass) {
	    hntrg_obs_ks[ict][ipt][imass] = ntrgHist.make<TH1D>(Form("hntrg_obs_ks_cent_%d_pT_%d_mass_%d", ict, ipt, imass), Form("%1.1f < p_{T} < %1.1f GeV/c & mass bin %d", npt_binedge[ipt], npt_binedge[ipt+1], imass), 2 ,0., 2.);
	  } //end of ks mass bin

      } //end of pt bin
      
	// hevent_V0_CH[ict] = ntrgHist.make<TH1D>(Form("hevent_V0_CH_%d",ict), "#Lambda+#bar{#Lambda}, K^{0}, V0, Charged-hadrons", 4 ,0., 4.);
      hntrg_ch[ict] = ntrgHist.make<TH1D>(Form("hntrg_ch_cent_%d", ict), "0.3 < p_{T} < 3.0 GeV/c", 1 ,0., 1.);
    }
    
    TFileDirectory sigmixHist = fs->mkdir("SigMix");
    
    hobs_sig_c2_lm_vs_ch.resize(ncentbins);
    hobs_sig_c2_ks_vs_ch.resize(ncentbins);
    hobs_mix_c2_lm_vs_ch.resize(ncentbins);
    hobs_mix_c2_ks_vs_ch.resize(ncentbins);
    
    hsig_c2_ch_vs_ch.resize(ncentbins);
    hmix_c2_ch_vs_ch.resize(ncentbins);
    
    for (unsigned int ict = 0; ict < ncentbins; ++ict) {
      hobs_sig_c2_lm_vs_ch[ict].resize(nptbins_lm);
      hobs_sig_c2_ks_vs_ch[ict].resize(nptbins);
      hobs_mix_c2_lm_vs_ch[ict].resize(nptbins_lm);
      hobs_mix_c2_ks_vs_ch[ict].resize(nptbins);
    
      for (unsigned int ipt = 0; ipt < nptbins_lm; ++ipt) {
	hobs_sig_c2_lm_vs_ch[ict][ipt].resize(nmassbins_lm);
	hobs_mix_c2_lm_vs_ch[ict][ipt].resize(nmassbins_lm);
	
	for (unsigned int imass = 0; imass < nmassbins_lm; ++imass) {
	  
	  hobs_sig_c2_lm_vs_ch[ict][ipt][imass] = sigmixHist.make<TH2D>(Form("hobs_sig_c2_lm_vs_ch_cent_%d_pT_%d_mass_%d", ict, ipt, imass), Form("hobs_sig_c2_lm_vs_ch_cent_%d_pT_%d_mass_%d", ict, ipt, imass), nBins_deta+1, eta_lowedge, eta_upedge, nBins_dphi-1, phi_lowedge, phi_upedge);
	  hobs_mix_c2_lm_vs_ch[ict][ipt][imass] = sigmixHist.make<TH2D>(Form("hobs_mix_c2_lm_vs_ch_cent_%d_pT_%d_mass_%d", ict, ipt, imass), Form("hobs_mix_c2_lm_vs_ch_cent_%d_pT_%d_mass_%d", ict, ipt, imass), nBins_deta+1, eta_lowedge, eta_upedge, nBins_dphi-1, phi_lowedge, phi_upedge);
	          
	} // end of lm_mass bin loop
      }

      for (unsigned int ipt = 0; ipt < nptbins; ++ipt) {
	hobs_sig_c2_ks_vs_ch[ict][ipt].resize(nmassbins_ks);
	hobs_mix_c2_ks_vs_ch[ict][ipt].resize(nmassbins_ks);

	for (unsigned int imass = 0; imass < nmassbins_ks; ++imass) {
	  hobs_sig_c2_ks_vs_ch[ict][ipt][imass] = sigmixHist.make<TH2D>(Form("hobs_sig_c2_ks_vs_ch_cent_%d_pT_%d_mass_%d", ict, ipt, imass), Form("hobs_sig_c2_ks_vs_ch_cent_%d_pT_%d_mass_%d", ict, ipt, imass), nBins_deta+1, eta_lowedge, eta_upedge, nBins_dphi-1, phi_lowedge, phi_upedge);
	  hobs_mix_c2_ks_vs_ch[ict][ipt][imass] = sigmixHist.make<TH2D>(Form("hobs_mix_c2_ks_vs_ch_cent_%d_pT_%d_mass_%d", ict, ipt, imass), Form("hobs_mix_c2_ks_vs_ch_cent_%d_pT_%d_mass_%d", ict, ipt, imass), nBins_deta+1, eta_lowedge, eta_upedge, nBins_dphi-1, phi_lowedge, phi_upedge);

	}// end of ks_mass bin loop
      } // end of pT bin loop
	
      hsig_c2_ch_vs_ch[ict] = sigmixHist.make<TH2D>(Form("hsig_c2_ch_vs_ch_cent_%d", ict), Form("hsig_c2_ch_vs_ch_cent_%d", ict), nBins_deta+1, eta_lowedge, eta_upedge, nBins_dphi-1, phi_lowedge, phi_upedge);
      hmix_c2_ch_vs_ch[ict] = sigmixHist.make<TH2D>(Form("hmix_c2_ch_vs_ch_cent_%d", ict), Form("hmix_c2_ch_vs_ch_cent_%d", ict), nBins_deta+1, eta_lowedge, eta_upedge, nBins_dphi-1, phi_lowedge, phi_upedge);
    }
 
}


RaghuV0Ana::~RaghuV0Ana()
{
  
   // do anything here that needs to be done at desctruction time
   // (e.g. close files, deallocate resources etc.)
  delete evt_; 
}

// ------------ method called for each event  ------------
void
RaghuV0Ana::analyze(const edm::Event& iEvent, const edm::EventSetup& iSetup)
{
  using namespace edm;
  //nTrk_corr_trg_ = std::vector<double>(pTmin_trg_.size(), 0.);
  //nTrk_corr_ass_ = std::vector<double>(pTmin_ass_.size(), 0.);
  
  zBestVtx1_ = -999.;

  ntrkoff = 0;
  centbin = -999;
  LoopV0Vertices(iEvent, iSetup);
  //LoopV0Vertices(iEvent, iSetup,false);

  //  std::cout<<"ntrk offline = "<<ntrkoff<<std::endl;

  if(ntrkoff ==0) return;
  hzvtx_->Fill(zBestVtx1_);
  hbin_->Fill(centbin);
  //std::cout<<"ntrk offline (after cut) = "<<ntrkoff<<std::endl;
  
  // ----- Fill and push evt containers -----                                                                                                    
  evt_->run   = iEvent.id().run();
  evt_->event = iEvent.id().event();
  evt_->zvtx  = zBestVtx1_;
  evt_->ntrkOFF  = ntrkoff;
  evt_->cent = centbin;
  
  evtVec_.push_back(*evt_);

  //std::cout<< "Total of " << evtVec_.size() << " events are selected!" << std::endl;
  // ----- Reset evt container -----                                                                                                             
  evt_->reset();
}  
 


// ------------ method called once each job just before starting event loop  ------------
void
RaghuV0Ana::beginJob()
{
}

// ------------ method called once each job just after ending the event loop  ------------
void
RaghuV0Ana::endJob()
{

  std::cout<< "Start sorting the events!" << std::endl;
  //std::sort(evtVec_.begin(),evtVec_.end());
  std::cout<< "Finish sorting the events!" << std::endl;
  
  std::cout<< "Total of " << evtVec_.size() << " events are selected!" << std::endl;
  
  std::cout<< "Start running correlation analysis!" << std::endl;

  unsigned int ievt = 0;
  for( unsigned int i = 0; i < evtVec_.size(); i++ )
    {
      
      if( i % 100 == 0 ) std::cout << "Processing " << i << "th event" << std::endl;
      ievt = i;
      
      //if (evtVec_[i].pVect_trg.size() == 0) std::cerr << "pVect_trg empty at i = " << i << std::endl;
      //if (evtVec_[i].pVect_daup_trg.size() == 0) std::cerr << "pVect_daup_trg empty at i = " << i << std::endl;
      //if (evtVec_[i].pVect_daun_trg.size() == 0) std::cerr << "pVect_daun_trg empty at i = " << i << std::endl;

      unsigned int itrack = 0;
      unsigned int ntrack_trg = evtVec_[ievt].pVect_trg[itrack].size();

      int ctbin = evtVec_[ievt].cent;
      int ict = hV0centbin->FindBin(ctbin) - 1;
      
      // ---- trigger track loop:: track loop 1
      for( unsigned int n = 0; n < ntrack_trg; n++) {
	//const TVector3& pvector_n = (evtVec_[ievt].pVect_trg[itrack])[n];
	TVector3 pvector_n = (evtVec_[ievt].pVect_trg[itrack])[n];
	int id_n = (evtVec_[ievt].chgVect_trg[itrack])[n];
	double mass = (evtVec_[ievt].massVect_trg[itrack])[n];
	double w_lm, w_ks, w_chtrg;
	
	double pt_n = pvector_n.Pt();
	double eta_n = pvector_n.Eta();
	double phi_n = pvector_n.Phi();
	
	int ipt_lm= -999, ipt_ks= -999;
	
	int imass_lm = -999; 
	int imass_ks = -999;

	//std::cout << "error 3" << std::endl;
	//trigger pt cuts
	//if (TMath::Abs(id_n) == 1) continue;
	if (TMath::Abs(id_n) == 1){
	  if (pt_n < pTmin_ch_ || pt_n >= pTmax_ch_) continue;
	  if (eta_n < Etamin_ || eta_n >= Etamax_) continue;

	  w_chtrg = (evtVec_[ievt].weightVect_all[itrack])[n];
	  hntrg_ch[ict]->AddBinContent(1, w_chtrg);
	  hpt_trigg_ks_endjob->Fill(pt_n);
	  
	}
	
        if (TMath::Abs(id_n) == 3122){
	  if (pt_n < pTmin_trg_lm_ || pt_n >= pTmax_trg_lm_) continue;
	  if (eta_n < Etamin_ || eta_n >= Etamax_) continue;

	  w_lm = (evtVec_[ievt].weightVect_all[itrack])[n];

	  ipt_lm = hV0pTbin_lm->FindBin(pt_n) - 1;
	  imass_lm = hV0massbin_lm->FindBin(mass) - 1;
	  if(imass_lm != -999 && ipt_lm != -999) hntrg_obs_lm[ict][ipt_lm][imass_lm]->AddBinContent(1, w_lm);
	  hpt_trigg_lm_endjob->Fill(pt_n);
	}
	
	else if (TMath::Abs(id_n) == 310){
	  if (pt_n < pTmin_trg_ks_ || pt_n >= pTmax_trg_ks_) continue;
          if (eta_n < Etamin_ || eta_n >= Etamax_) continue;

	  w_ks = (evtVec_[ievt].weightVect_all[itrack])[n];

	  ipt_ks = hV0pTbin->FindBin(pt_n) - 1;
	  imass_ks = hV0massbin_ks->FindBin(mass) - 1;
	  if(imass_ks != -999 && ipt_ks != -999) hntrg_obs_ks[ict][ipt_ks][imass_ks]->AddBinContent(1, w_ks);
	}
	
	// ---- Daughter particles informations 
	TVector3 pvector_daup_n = (evtVec_[ievt].pVect_daup_trg[itrack])[n];
	TVector3 pvector_daun_n = (evtVec_[ievt].pVect_daun_trg[itrack])[n];
	
	// ---- Daughter no.1 : positive
	double pt_daup_n = pvector_daup_n.Pt();
	double eta_daup_n = pvector_daup_n.Eta();
	double phi_daup_n = pvector_daup_n.Phi();
	
	// ---- Daughter no.2 : negative
	double pt_daun_n = pvector_daun_n.Pt();
	double eta_daun_n = pvector_daun_n.Eta();
	double phi_daun_n = pvector_daun_n.Phi();
	
	// ---- associated track loop:: track loop 2
	for( unsigned int m = 0; m < ntrack_trg; m++) {
	  TVector3 pvector_m = (evtVec_[ievt].pVect_trg[itrack])[m];
	  int id_m = (evtVec_[ievt].chgVect_trg[itrack])[m];
	  double w_ch;
	  
	  double pt_m = pvector_m.Pt();
	  double eta_m = pvector_m.Eta();
	  double phi_m = pvector_m.Phi();

	  //associate pt cuts
	  if (TMath::Abs(id_m) == 3122 || TMath::Abs(id_m) == 310) continue;
	  
	  if (TMath::Abs(id_m) == 1){
	    if (pt_m < pTmin_ch_ || pt_m >= pTmax_ch_) continue;
            if (eta_m < Etamin_ || eta_m >= Etamax_) continue;

	    w_ch = (evtVec_[ievt].weightVect_all[itrack])[m];
          }

	  if(pt_n < pt_m) continue;
	  if (phi_daup_n == phi_m && eta_daup_n == eta_m && pt_daup_n == pt_m) continue;
	  if (phi_daun_n == phi_m && eta_daun_n == eta_m && pt_daun_n == pt_m) continue;
	  
	  double deltaPhi = (phi_m - phi_n);
	  double deltaEta = (eta_m - eta_n);

	  if(deltaPhi> 1.5*TMath::Pi()){
	    deltaPhi = deltaPhi - 2.0*TMath::Pi();
	  }
	  else if(deltaPhi < -0.5*TMath::Pi()) {
	    deltaPhi = deltaPhi + 2.0*TMath::Pi();
	  }

	  double deltaPhi2 = (phi_n - phi_m);
          if(deltaPhi2> 1.5*TMath::Pi()){
            deltaPhi2 = deltaPhi2 - 2.0*TMath::Pi();
          }
          else if(deltaPhi2 < -0.5*TMath::Pi()) {
            deltaPhi2 = deltaPhi2 + 2.0*TMath::Pi();
          }
	  
	  if (TMath::Abs(id_n) == 3122 && TMath::Abs(id_m) == 1){
	    if(imass_lm != -999 && ipt_lm != -999) hobs_sig_c2_lm_vs_ch[ict][ipt_lm][imass_lm]->Fill( fabs(deltaEta), deltaPhi, (1.0*w_lm*w_ch)/4.0 );
	    if(imass_lm != -999 && ipt_lm != -999) hobs_sig_c2_lm_vs_ch[ict][ipt_lm][imass_lm]->Fill( -fabs(deltaEta), deltaPhi, (1.0*w_lm*w_ch)/4.0 );
	    if(imass_lm != -999 && ipt_lm != -999) hobs_sig_c2_lm_vs_ch[ict][ipt_lm][imass_lm]->Fill( fabs(deltaEta), deltaPhi2, (1.0*w_lm*w_ch)/4.0 );
	    if(imass_lm != -999 && ipt_lm != -999) hobs_sig_c2_lm_vs_ch[ict][ipt_lm][imass_lm]->Fill( -fabs(deltaEta), deltaPhi2, (1.0*w_lm*w_ch)/4.0 );
	  }
	  else if (TMath::Abs(id_n) == 310 && TMath::Abs(id_m) == 1){
	    if(imass_ks != -999 && ipt_ks != -999) hobs_sig_c2_ks_vs_ch[ict][ipt_ks][imass_ks]->Fill(fabs(deltaEta), deltaPhi, (1.0*w_ks*w_ch)/4.0 );
	    if(imass_ks != -999 && ipt_ks != -999) hobs_sig_c2_ks_vs_ch[ict][ipt_ks][imass_ks]->Fill(-fabs(deltaEta), deltaPhi, (1.0*w_ks*w_ch)/4.0 );
	    if(imass_ks != -999 && ipt_ks != -999) hobs_sig_c2_ks_vs_ch[ict][ipt_ks][imass_ks]->Fill(fabs(deltaEta), deltaPhi2, (1.0*w_ks*w_ch)/4.0 );
	    if(imass_ks != -999 && ipt_ks != -999) hobs_sig_c2_ks_vs_ch[ict][ipt_ks][imass_ks]->Fill(-fabs(deltaEta), deltaPhi2, (1.0*w_ks*w_ch)/4.0 );
	  }
	  else if (TMath::Abs(id_n) == 1 && TMath::Abs(id_m) == 1){
	    hsig_c2_ch_vs_ch[ict]->Fill(fabs(deltaEta), deltaPhi, (1.0*w_chtrg*w_ch)/4.0 );
	    hsig_c2_ch_vs_ch[ict]->Fill(-fabs(deltaEta), deltaPhi, (1.0*w_chtrg*w_ch)/4.0 );
	    hsig_c2_ch_vs_ch[ict]->Fill(fabs(deltaEta), deltaPhi2, (1.0*w_chtrg*w_ch)/4.0 );
	    hsig_c2_ch_vs_ch[ict]->Fill(-fabs(deltaEta), deltaPhi2, (1.0*w_chtrg*w_ch)/4.0 );
	  }

	}//end of associated track loop
      }//end of trigger track loop

      //~~~~~~~~~~~~ Mixing Correlation ~~~~~~~~~~~
      // bkgFactor = 5;

      unsigned int mixstart = ievt+1;
      unsigned int mixend   = (int)evtVec_.size();

      if(mixstart > (0.5*(evtVec_.size())))         //default: 0.7, 0.5
        {
           mixstart = (0.4*(evtVec_.size()));
           mixend   = (int)evtVec_.size();
        }

       int nmix = 0;

       
       for( unsigned int jevt = mixstart; jevt < mixend; jevt++ ) {
	if(jevt == ievt) continue;

	if( evtVec_[ievt].run == evtVec_[jevt].run && evtVec_[ievt].event == evtVec_[jevt].event ) continue;

	double deltazvtx = evtVec_[ievt].zvtx-evtVec_[jevt].zvtx;
	if(fabs(deltazvtx) > 0.5) continue;

	int ctbin_j = evtVec_[jevt].cent;
	int jct = hV0centbin->FindBin(ctbin_j) - 1;

	double deltantrkoff = evtVec_[ievt].ntrkOFF-evtVec_[jevt].ntrkOFF;
	if(fabs(deltantrkoff) > 10) continue;

	if(ict != jct) continue;
	//std::cout << "ctbin & ict = " << ctbin << " , " << ict <<  "ctbin_j & jct= " << ctbin_j << " , " << jct <<std::endl;
	//std::cout << "ctbin =" << ctbin << "ctbin_j =" << ctbin_j <<std::endl;

	unsigned int nsize_ievt_trg = evtVec_[ievt].pVect_trg[itrack].size();
	unsigned int nsize_jevt_trg = evtVec_[jevt].pVect_trg[itrack].size();
	//unsigned int nsize_jevt = evtVec_[jevt].pVect[itrack].size();
	
	if (nsize_ievt_trg ==0 || nsize_jevt_trg ==0) continue;

	for(unsigned int n = 0; n < nsize_ievt_trg; n++) {
	  TVector3 pvector_n = (evtVec_[ievt].pVect_trg[itrack])[n];
	  int id_n = (evtVec_[ievt].chgVect_trg[itrack])[n];
	  double mass = (evtVec_[ievt].massVect_trg[itrack])[n];
	  double w_lm, w_ks, w_chtrg; 
	  
	  double pt_n = pvector_n.Pt();
	  double eta_n = pvector_n.Eta();
	  double phi_n = pvector_n.Phi();

	  int ipt_lm= -999, ipt_ks= -999;
	  int imass_lm = -999;
	  int imass_ks = -999;

	  //trigger pt cuts
	  //if (TMath::Abs(id_n) == 1) continue;
	  if (TMath::Abs(id_n) == 1){
	    if (pt_n < pTmin_ch_ || pt_n >= pTmax_ch_) continue;
	    if (eta_n < Etamin_ || eta_n >= Etamax_) continue;

	    w_chtrg = (evtVec_[ievt].weightVect_all[itrack])[n]; 
	  }
	  
	  if (TMath::Abs(id_n) == 3122){
	    if (pt_n < pTmin_trg_lm_ || pt_n >= pTmax_trg_lm_) continue;
	    if (eta_n < Etamin_  || eta_n >= Etamax_ ) continue;
	    imass_lm = hV0massbin_lm->FindBin(mass) - 1;
	    ipt_lm = hV0pTbin_lm->FindBin(pt_n) - 1;

	    w_lm = (evtVec_[ievt].weightVect_all[itrack])[n];

	  }
	  
	  else if (TMath::Abs(id_n) == 310){
	    if (pt_n < pTmin_trg_ks_ || pt_n >= pTmax_trg_ks_) continue;
            if (eta_n < Etamin_  || eta_n >= Etamax_ ) continue;
	    imass_ks = hV0massbin_ks->FindBin(mass) - 1;
	    ipt_ks = hV0pTbin->FindBin(pt_n) - 1;

	    w_ks = (evtVec_[ievt].weightVect_all[itrack])[n];
	  }

	  // ---- Daughter particles informations
	  TVector3 pvector_daup_n = (evtVec_[ievt].pVect_daup_trg[itrack])[n];
	  TVector3 pvector_daun_n = (evtVec_[ievt].pVect_daun_trg[itrack])[n]; 

	  // ---- Daughter no.1 : positive
	  double pt_daup_n = pvector_daup_n.Pt();
	  double eta_daup_n = pvector_daup_n.Eta();
	  double phi_daup_n = pvector_daup_n.Phi();
	  
	  // ---- Daughter no.2 : negative
	  double pt_daun_n = pvector_daun_n.Pt();
	  double eta_daun_n = pvector_daun_n.Eta();
	  double phi_daun_n = pvector_daun_n.Phi();
	  
	  // ---- associated track loop:: track loop 2
	  for(unsigned int m = 0; m < nsize_jevt_trg; m++) {
	    TVector3 pvector_m = (evtVec_[jevt].pVect_trg[itrack])[m];
	    int id_m = (evtVec_[jevt].chgVect_trg[itrack])[m];
	    double w_ch;
	    
	    double pt_m = pvector_m.Pt();
	    double eta_m = pvector_m.Eta();
	    double phi_m = pvector_m.Phi();

	    //associate pt cuts
	    if (TMath::Abs(id_m) == 3122 || TMath::Abs(id_m) == 310) continue;
	    
	    if (TMath::Abs(id_m) == 1){
	      if (pt_m < pTmin_ch_ || pt_m >= pTmax_ch_) continue;
              if(eta_m < Etamin_ || eta_m >= Etamax_) continue;

	      w_ch = (evtVec_[jevt].weightVect_all[itrack])[m]; 
            }

	    if(pt_n < pt_m) continue;
	    if (phi_daup_n == phi_m && eta_daup_n == eta_m && pt_daup_n == pt_m) continue;
	    if (phi_daun_n == phi_m && eta_daun_n == eta_m && pt_daun_n == pt_m) continue; 
	    
	    double deltaPhi = (phi_m - phi_n);
	    double deltaEta = (eta_m - eta_n);
	    
	    if(deltaPhi> 1.5*TMath::Pi()){
	      deltaPhi = deltaPhi - 2.0*TMath::Pi();
	    }
	    else if(deltaPhi < -0.5*TMath::Pi()) {
	      deltaPhi = deltaPhi + 2.0*TMath::Pi();
	    }

	    double deltaPhi2 = (phi_n - phi_m);
            if(deltaPhi2> 1.5*TMath::Pi()){
              deltaPhi2 = deltaPhi2 - 2.0*TMath::Pi();
            }
            else if(deltaPhi2 < -0.5*TMath::Pi()) {
              deltaPhi2 = deltaPhi2 + 2.0*TMath::Pi();
            }
	    	    	    

	    if (TMath::Abs(id_n) == 3122 && TMath::Abs(id_m) == 1){
	      if(imass_lm != -999 && ipt_lm != -999) hobs_mix_c2_lm_vs_ch[ict][ipt_lm][imass_lm]->Fill(fabs(deltaEta), deltaPhi, (1.0*w_lm*w_ch)/4.0 );
	      if(imass_lm != -999 && ipt_lm != -999) hobs_mix_c2_lm_vs_ch[ict][ipt_lm][imass_lm]->Fill(-fabs(deltaEta), deltaPhi, (1.0*w_lm*w_ch)/4.0 );
	      if(imass_lm != -999 && ipt_lm != -999) hobs_mix_c2_lm_vs_ch[ict][ipt_lm][imass_lm]->Fill(fabs(deltaEta), deltaPhi2, (1.0*w_lm*w_ch)/4.0 );
	      if(imass_lm != -999 && ipt_lm != -999) hobs_mix_c2_lm_vs_ch[ict][ipt_lm][imass_lm]->Fill(-fabs(deltaEta), deltaPhi2, (1.0*w_lm*w_ch)/4.0 );
	    }
	    
	    else if (TMath::Abs(id_n) == 310 && TMath::Abs(id_m) == 1){
	      if(imass_ks != -999 && ipt_ks != -999) hobs_mix_c2_ks_vs_ch[ict][ipt_ks][imass_ks]->Fill(fabs(deltaEta), deltaPhi, (1.0*w_ks*w_ch)/4.0);
	      if(imass_ks != -999 && ipt_ks != -999) hobs_mix_c2_ks_vs_ch[ict][ipt_ks][imass_ks]->Fill(-fabs(deltaEta), deltaPhi, (1.0*w_ks*w_ch)/4.0);
	      if(imass_ks != -999 && ipt_ks != -999) hobs_mix_c2_ks_vs_ch[ict][ipt_ks][imass_ks]->Fill(fabs(deltaEta), deltaPhi2, (1.0*w_ks*w_ch)/4.0);
	      if(imass_ks != -999 && ipt_ks != -999) hobs_mix_c2_ks_vs_ch[ict][ipt_ks][imass_ks]->Fill(-fabs(deltaEta), deltaPhi2, (1.0*w_ks*w_ch)/4.0);
	    }

	    else if (TMath::Abs(id_n) == 1 && TMath::Abs(id_m) == 1){
	      hmix_c2_ch_vs_ch[ict]->Fill(fabs(deltaEta), deltaPhi, (1.0*w_chtrg*w_ch)/4.0 );
	      hmix_c2_ch_vs_ch[ict]->Fill(-fabs(deltaEta), deltaPhi, (1.0*w_chtrg*w_ch)/4.0 );
	      hmix_c2_ch_vs_ch[ict]->Fill(fabs(deltaEta), deltaPhi2, (1.0*w_chtrg*w_ch)/4.0 );
	      hmix_c2_ch_vs_ch[ict]->Fill(-fabs(deltaEta), deltaPhi2, (1.0*w_chtrg*w_ch)/4.0 );
	    }

	  }//end of associated track loop 
	}//end of trigger track loop
	nmix++;
	if(nmix >= 5) break; 
      }// end of mixing event loop
       //std::cout << "nmix:" << nmix <<std::endl; 
    }//end of the 1st event loop 
  
}
// ------------ method fills 'descriptions' with the allowed parameters for the module  ------------
void
RaghuV0Ana::fillDescriptions(edm::ConfigurationDescriptions& descriptions) {
  //The following says we do not know what parameters are allowed so do no validation
  // Please change this to state exactly what you do use, even if it is no parameters
  edm::ParameterSetDescription desc;
  desc.setUnknown();
  descriptions.addDefault(desc);
}

//=========================================================================================================================
void
RaghuV0Ana::LoopV0Vertices(const edm::Event& iEvent,
				   const edm::EventSetup& iSetup)
  
  
{
  using namespace edm;
  using namespace std;
  using namespace reco;
  
  edm::Handle< reco::VertexCollection > vertices;
  iEvent.getByToken(vtxTags_, vertices);

  edm::Handle<pat::PackedCandidateCollection> packed;
  iEvent.getByToken(packedCandToken_, packed);

  edm::Handle<edm::Association<reco::TrackCollection>> pc2track;
  iEvent.getByToken(pc2trackAssocToken_, pc2track);


  if (!packed.isValid()) {
  edm::LogError("RaghuV0Ana") << "packedPFCandidates not found in this file.";
  return; // or `continue;` inside a loop over events
  }
  if (!pc2track.isValid()) {
    edm::LogError("RaghuV0Ana") << "unpackedTracksAndVertices association missing.";
    return;
  }
  
  //if(!vertices->size())
  if (!vertices.isValid() || vertices->empty()) 
    {
      std::cout<<"Invalid or empty vertex collection!"<<std::endl;
      return;
    }
  
  reco::VertexCollection recoVertices = *vertices;
  
  sort(recoVertices.begin(), recoVertices.end(), [](const reco::Vertex &a, const reco::Vertex &b){
      return a.tracksSize() > b.tracksSize();
    });


  unsigned int primaryvtx = 0;  
  for ( primaryvtx = 0; primaryvtx < recoVertices.size(); primaryvtx++ ) {
    if ( (!recoVertices[primaryvtx].isFake())
         && fabs(recoVertices[primaryvtx].z()) <= 25.
         && recoVertices[primaryvtx].position().Rho() <= 2.0) break;
    //         && recoVertices[primaryvtx].tracksSize() >=2  ) break;
    
    //std::cout<<"event no.: "<< iEvent.id().event() << " " <<"pvtx:" << primaryvtx << " " << "ptsq_sum:" << ptsq_sum << std::endl;
    // std::cout << "event no.: "<< iEvent.id().event() << " " <<"pvtx:" << primaryvtx << " " << "recoVertices[primaryvtx].tracksSize(): " << recoVertices[primaryvtx].tracksSize() << std::endl;
  }

  // std::cout << "recoVertices.size():" << recoVertices.size() << std::endl;
  // std::cout << primaryvtx << std::endl;
  /*
  if (primaryvtx >= recoVertices.size()) {
    edm::LogWarning("BadVertex") << "Primary vertex index out of range or vertex collection is empty!";
    return;
  }
  */

  
  //if(recoVertices.size() != 1) return;       //nvtx = 1 condition
  
  //reco::Vertex const * pv = &recoVertices[primaryvtx];
   reco::Vertex const * pv = &recoVertices[0];
 
  // std::cout << "recoVertices.size():" << pv->size() << std::endl;
  double zBestVtx_ = pv->z();
  if (zBestVtx_ < zminVtx_ || zBestVtx_ > zmaxVtx_ ) return;
  zBestVtx1_ = zBestVtx_;

  //  hzvtx_->Fill(zBestVtx1_);  
  //************ added for cent
  edm::Handle<pat::PackedCandidateCollection> pfCandidates;
  iEvent.getByToken(packedCandToken_, pfCandidates);
 
  double hiHF_pf = 0;
 
  for (const auto& pfcand : *pfCandidates) {
    if (pfcand.pdgId() != 1 && pfcand.pdgId() != 2) continue;
    if (pfcand.et() < 0.0) continue;
    
    if (fabs(pfcand.eta()) > 3.0 && fabs(pfcand.eta()) < 5.2) {
      hiHF_pf += pfcand.et();
    }
  }
    centbin = getHiBinFromhiHF(hiHF_pf); 
    // if (centbin >= 160) return;                ///default
    if (centbin < 140 || centbin >= 160) return;
    //if (centbin >= 100) return;  
    
    int icent = hV0centbin->FindBin(centbin) - 1;
    //std::cout << "centbin after pfcand = " << centbin <<"  & icent = "<<icent<< std::endl;
    
    //*****************
  const TransientTrackBuilder* theB = &iSetup.getData(theBToken_);

  edm::Handle< reco::VertexCompositeCandidateCollection > V0s;
  iEvent.getByToken(V0Src_, V0s);

  edm::Handle< reco::VertexCompositeCandidateCollection > V0s_lm;
  iEvent.getByToken(V0Src_lm_, V0s_lm);
  
  edm::Handle<int> pCent;
  iEvent.getByToken(dbCent_, pCent);

  V0pt_vect.resize(0);
  V0eta_vect.resize(0);
  V0phi_vect.resize(0);
  V0id_vect.resize(0);
  V0mass_vect.resize(0);

  pdau_pt_vect.resize(0);
  pdau_eta_vect.resize(0);
  pdau_phi_vect.resize(0);
  pdau_chi2_vect.resize(0);

  ndau_pt_vect.resize(0);
  ndau_eta_vect.resize(0);
  ndau_phi_vect.resize(0);
  ndau_chi2_vect.resize(0);

  V0pt_vect_unmatch.resize(0);
  V0eta_vect_unmatch.resize(0);
  V0phi_vect_unmatch.resize(0);
  V0id_vect_unmatch.resize(0);
  V0mass_vect_unmatch.resize(0);

  pdau_pt_vect_unmatch.resize(0);
  pdau_eta_vect_unmatch.resize(0);
  pdau_phi_vect_unmatch.resize(0);
  pdau_chi2_vect_unmatch.resize(0);

  ndau_pt_vect_unmatch.resize(0);
  ndau_eta_vect_unmatch.resize(0);
  ndau_phi_vect_unmatch.resize(0);
  ndau_chi2_vect_unmatch.resize(0);

  //~~~~~~~~~~~~~~~~~~~~~~~~~~~~~Ks0~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

  int nevent_ks= 0;

  reco::VertexCompositeCandidateCollection recV0 = *V0s;
  for ( reco::VertexCompositeCandidateCollection::const_iterator recoV0s = recV0.begin();
	recoV0s != recV0.end();
	++recoV0s)
    {
      
      V0id = recoV0s->pdgId();
      if (fabs(V0id) != 310) continue; 
      V0mass = recoV0s->mass();
      
      //Float_t pdgmass = 1.115683;
      //Float_t pdgmass = 0.497611;
	V0phi = recoV0s->phi();
	V0pt = recoV0s->pt();
	V0eta = recoV0s->eta();
	V0rapidity = recoV0s->rapidity();
	V0phi = recoV0s->phi();
	GlobalPoint displacementFromPV ( (pv->x() - recoV0s->vx()), (pv->y() - recoV0s->vy()), (pv->z() - recoV0s->vz()) ) ;
	V0lxyz = (displacementFromPV.mag());
	V0Chi2 = recoV0s->vertexChi2();
	
	//3d pointing angle
	V0cosThetaXYZ = -(displacementFromPV.x()*recoV0s->px() + displacementFromPV.y()*recoV0s->py() + displacementFromPV.z()*recoV0s->pz()) / ( displacementFromPV.mag()*sqrt(recoV0s->px()*recoV0s->px() + recoV0s->py()*recoV0s->py() + recoV0s->pz()*recoV0s->pz()) );
	
	//std::cout << "error8" << std::endl;
	SMatrixSym3D V0totalCov = pv->covariance() + recoV0s->vertexCovariance();
      
	SVector3 V0distVecXYZ(displacementFromPV.x(), displacementFromPV.y(), displacementFromPV.z());
	V0distMagXYZ = ROOT::Math::Mag(V0distVecXYZ);
	V0sigmaDistMagXYZ = sqrt(ROOT::Math::Similarity(V0totalCov, V0distVecXYZ)) / V0distMagXYZ;
	V0vtxDecaySigXYZ = V0distMagXYZ/V0sigmaDistMagXYZ;
	
	dca = -999.;
	double dauLongImpactSig1 = -999.;
	double dauTransImpactSig1 = -999.;
	double dauLongImpactSig2 = -999.;
	double dauTransImpactSig2 = -999.;

	double daupx1 = -999;
        double daupy1 = -999;
        double daupz1 = -999;
        double pd1 = -999;

        double daupx2 = -999;
        double daupy2 = -999;
        double daupz2 = -999;
        double pd2 = -999;

	TVector3 pV0vector(recoV0s->px(), recoV0s->py(), recoV0s->pz());
	
	double alpha , qt ,v0masspiproton1,v0masspiproton2;
	
	if ( recoV0s->numberOfDaughters() != 2 ) continue;

	const reco::Candidate* d0 = recoV0s->daughter(0);
        const reco::Candidate* d1 = recoV0s->daughter(1);
        if (!d0 || !d1) continue;

        const auto* rc0 = dynamic_cast<const reco::RecoChargedCandidate*>(d0);
        const auto* rc1 = dynamic_cast<const reco::RecoChargedCandidate*>(d1);
        if (!(rc0 && rc1)) continue;


	double daupT0 = rc0->pt();
        double daupT1 = rc1->pt();
        double daueta0 = rc0->eta();
        double daueta1 = rc1->eta();
        double dauphi0 = rc0->phi();
        double dauphi1 = rc1->phi();

        //hV0pT_before_->Fill(V0pt);

	double M0 =  0.13957;
        double M1 =  0.13957;

        double px1 = daupT0 * cos(dauphi0);
        double py1 = daupT0 * sin(dauphi0);
        double pz1 = daupT0 * sinh(daueta0);
        TLorentzVector pdau1;
        pdau1.SetPtEtaPhiM(daupT0, daueta0, dauphi0, M0);
        daupx1 = pdau1.Px();
        daupy1 = pdau1.Py();
        daupz1 = pdau1.Pz();
        pd1 = pdau1.P();

        double px2 = daupT1 * cos(dauphi1);
        double py2 = daupT1 * sin(dauphi1);
        double pz2 = daupT1 * sinh(daueta1);
        TLorentzVector pdau2;
        pdau2.SetPtEtaPhiM(daupT1, daueta1, dauphi1, M1);
        daupx2 = pdau2.Px();
        daupy2 = pdau2.Py();
        daupz2 = pdau2.Pz();
        pd2 = pdau2.P();
	
	TVector3 dauvec1(daupx1,daupy1,daupz1);
        TVector3 dauvec2(daupx2,daupy2,daupz2);
        TVector3 dauvecsum(dauvec1+dauvec2);

	double pV0mag = pV0vector.Mag();
        int charge0 = 0, charge1 = 0;
        charge0 = rc0->charge();
        charge1 = rc1->charge();

        if (charge0 * charge1 >= 0) continue;

        TVector3 vPos = (charge0 > 0) ? dauvec1 : dauvec2;
        TVector3 vNeg = (charge0 > 0) ? dauvec2 : dauvec1;

        double Ppos = pV0vector.Dot(vPos) / pV0mag;
        double Pneg = pV0vector.Dot(vNeg) / pV0mag;
        double denom = (Ppos + Pneg);
        qt = (vPos.Cross(vNeg)).Mag() / pV0mag;
        alpha = (Ppos - Pneg) / denom;
	
        if(V0mass > 0.486 && V0mass < 0.505 && (V0pt > 2.0)){
          harmen_wocut_->Fill(alpha,qt);
        }

	//std::cout << "qt(before cuts): " << qt << "   " << "alpha(before cuts): " << alpha << std::endl;                                          

        v0masspiproton1 = sqrt((sqrt(0.93827*0.93827+pd1*pd1)+sqrt(0.13957*0.13957+pd2*pd2))*(sqrt(0.93827*0.93827+pd1*pd1)+sqrt (0.13957*0.13957+pd2*pd2))-dauvecsum.Mag2());
        v0masspiproton2 = sqrt((sqrt(0.13957*0.13957+pd1*pd1)+sqrt(0.93827*0.93827+pd2*pd2))*(sqrt(0.13957*0.13957+pd1*pd1)+sqrt (0.93827*0.93827+pd2*pd2))-dauvecsum.Mag2());

        if (v0masspiproton1 == -999 || v0masspiproton2 == -999) continue;
	
        //std::cout << "v0masspiproton1(before cut) : " << v0masspiproton1 << "  " << "v0masspiproton2(before cut) : " << v0masspiproton2 << "  " <<"mis_la_range_(before cut) : " << mis_la_range_ <<std::endl;

        if((v0masspiproton1>=(1.115683-mis_la_range_) && v0masspiproton1<=(1.115683+mis_la_range_)) || (v0masspiproton2>=(1.115683-mis_la_range_) && v0masspiproton2<=(1.115683+mis_la_range_)) ) continue;

        hV0pT_before_->Fill(V0pt);

        //std::cout << "qt_ks(after cuts): " << qt << "   " << "alpha_ks(after cuts): " << alpha << std::endl;

	
	if ( V0pt > pTmax_ || V0pt < pTmin_ ) continue;
	if ( V0rapidity > Rapmax_ || V0rapidity < Rapmin_ ) continue;
	//if ( V0eta > Etamax_ || V0eta < Etamin_ ) continue;
	if ( V0mass > Massmax_ || V0mass < Massmin_ ) continue;
	if (V0vtxDecaySigXYZ < DecaySigXYZmin_) continue;       //bismita
	if (V0cosThetaXYZ < ThetaXYZmin_) continue;
	
	//std::cout<<"pt & eta(ks):" << V0pt << " " << V0eta << std::endl;
	//std::cout << "dca : " << dca << std::endl;

	 //Define kshort efficiency weight                                                                                                                                                          
        double w_ks = 1.;
        double eff_ks = (hEff_3D_ks->GetBinContent(hEff_3D_ks->GetXaxis()->FindBin(V0pt),hEff_3D_ks->GetYaxis()->FindBin(V0eta), hEff_3D_ks->GetZaxis()->FindBin(centbin)));

        if(eff_ks > 0.){                                                                                                                                                                              
          w_ks = 1./(eff_ks);                                                                                                                                                                         
        }else{
          w_ks = 1.;
        }         

	//std::cout << "w_ks : " << w_ks << "   " <<"pT :" << V0pt << "    " << " rapidity: " << V0rapidity << "  " << "cent :" << centbin <<std::endl;
	int ipt = hV0pTbin->FindBin(V0pt) - 1;
	kshort_pT[icent][ipt]->Fill(V0mass, w_ks);

	if(V0mass > 0.486 && V0mass < 0.505 && (V0pt > 2.0)){
          harmen_wcut_ ->Fill(alpha,qt);
          //std::cout << "qt_ks(after cuts): " << qt << "   " << "alpha_ks(after cuts): " << alpha << std::endl;                                                     
        }

	hV0mass_wocut_->Fill(V0mass);
	hV0pT_->Fill(V0pt); 
	hV0phi_->Fill(V0phi);
	hV0eta_->Fill(V0eta);
	hchi2_->Fill(V0Chi2);
		
	bool is_dcut = kTRUE;
	int index1 = GetpTbin(V0pt, is_dcut);
	if(index1 == -1) continue;
	
	if(V0mass > 0.435 && V0mass < 0.560 ) //cuts obtained from Raghu's PbPb paper
	  {
	    AssignpTbins(V0pt, V0eta, V0phi, V0id, V0mass, w_ks, pdau_pt, pdau_eta, pdau_phi, ndau_pt, ndau_eta, ndau_phi, index1, is_dcut);
	    nevent_ks++;
	    //nevent_ks[icent]++;
	  }
	
    }
  
  //~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ lambda ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  
  int nevent_lm = 0;
  
    reco::VertexCompositeCandidateCollection recV0lm = *V0s_lm;
    for ( reco::VertexCompositeCandidateCollection::const_iterator recoV0slm = recV0lm.begin();
          recoV0slm != recV0lm.end();
          ++recoV0slm)
      {
	V0id_lm = recoV0slm->pdgId();
	if (fabs(V0id_lm) != 3122) continue;
	V0mass_lm = recoV0slm->mass();

	V0phi_lm = recoV0slm->phi();
        V0pt_lm = recoV0slm->pt();
        V0eta_lm = recoV0slm->eta();
        V0rapidity_lm = recoV0slm->rapidity();
        V0phi_lm = recoV0slm->phi();
        GlobalPoint displacementFromPV ( (pv->x() - recoV0slm->vx()), (pv->y() - recoV0slm->vy()), (pv->z() - recoV0slm->vz()) ) ;
        V0lxyz_lm = (displacementFromPV.mag());
        V0Chi2_lm = recoV0slm->vertexChi2();

	//3d pointing angle
        V0cosThetaXYZ_lm = -(displacementFromPV.x()*recoV0slm->px() + displacementFromPV.y()*recoV0slm->py() + displacementFromPV.z()*recoV0slm->pz()) / ( displacementFromPV.mag()*sqrt(recoV0slm->px()*recoV0slm->px() + recoV0slm->py()*recoV0slm->py() + recoV0slm->pz()*recoV0slm->pz()) );

	SMatrixSym3D V0totalCovlm = pv->covariance() + recoV0slm->vertexCovariance();

        SVector3 V0distVecXYZlm(displacementFromPV.x(), displacementFromPV.y(), displacementFromPV.z());
        V0distMagXYZ_lm = ROOT::Math::Mag(V0distVecXYZlm);
        V0sigmaDistMagXYZ_lm = sqrt(ROOT::Math::Similarity(V0totalCovlm, V0distVecXYZlm)) / V0distMagXYZ_lm;
        V0vtxDecaySigXYZ_lm = V0distMagXYZ_lm/V0sigmaDistMagXYZ_lm;

	//std::cout << "error 6 " << std::endl; 
	dca_lm = -999.;
        double dauLongImpactSig1_lm = -999.;
        double dauTransImpactSig1_lm = -999.;
        double dauLongImpactSig2_lm = -999.;
        double dauTransImpactSig2_lm = -999.;
	bool is_dcut = kTRUE;

	TVector3 pV0vectorlm(recoV0slm->px(), recoV0slm->py(), recoV0slm->pz());

	double v0masspipi,v0massee;

	if ( recoV0slm->numberOfDaughters() != 2 ) continue;

	const reco::Candidate* d0l = recoV0slm->daughter(0);
        const reco::Candidate* d1l = recoV0slm->daughter(1);
        if (!d0l || !d1l) continue;

        const auto* rc0l = dynamic_cast<const reco::RecoChargedCandidate*>(d0l);
        const auto* rc1l = dynamic_cast<const reco::RecoChargedCandidate*>(d1l);
        if (!(rc0l && rc1l)) continue;

	double daupT0 = rc0l->pt();
        double daupT1 = rc1l->pt();
        double daueta0 = rc0l->eta();
        double daueta1 = rc1l->eta();
        double dauphi0 = rc0l->phi();
        double dauphi1 = rc1l->phi();

	double daupx1_lm = -999;
        double daupy1_lm = -999;
        double daupz1_lm = -999;
        double pd1_lm = -999;

        double daupx2_lm = -999;
        double daupy2_lm = -999;
        double daupz2_lm = -999;
        double pd2_lm = -999;

        double M0 = (daupT0 > daupT1) ? 0.93827 : 0.13957;
        double M1 = (daupT0 > daupT1) ? 0.13957 : 0.93827;

        double px1_lm = daupT0 * cos(dauphi0);
        double py1_lm = daupT0 * sin(dauphi0);
        double pz1_lm = daupT0 * sinh(daueta0);

        TLorentzVector pdau1_lm;
        pdau1_lm.SetPtEtaPhiM(daupT0, daueta0, dauphi0, M0);
        daupx1_lm = pdau1_lm.Px();
        daupy1_lm = pdau1_lm.Py();
        daupz1_lm = pdau1_lm.Pz();
        pd1_lm = pdau1_lm.P();

        double px2_lm = daupT1 * cos(dauphi1);
        double py2_lm = daupT1 * sin(dauphi1);
        double pz2_lm = daupT1 * sinh(daueta1);

        TLorentzVector pdau2_lm;
        pdau2_lm.SetPtEtaPhiM(daupT1, daueta1, dauphi1, M1);
        daupx2_lm = pdau2_lm.Px();
        daupy2_lm = pdau2_lm.Py();
        daupz2_lm = pdau2_lm.Pz();
        pd2_lm = pdau2_lm.P();
	
	TVector3 dauvec1_lm(daupx1_lm,daupy1_lm,daupz1_lm);
        TVector3 dauvec2_lm(daupx2_lm,daupy2_lm,daupz2_lm);
        TVector3 dauvecsum_lm(dauvec1_lm+dauvec2_lm);

	double pV0mag = pV0vectorlm.Mag();
        int charge0 = 0, charge1 = 0;
        charge0 = rc0l->charge();
        charge1 = rc1l->charge();

        if (charge0 * charge1 >= 0) continue;

        TVector3 vPos = (charge0 > 0) ? dauvec1_lm : dauvec2_lm;
        TVector3 vNeg = (charge0 > 0) ? dauvec2_lm : dauvec1_lm;

	double Ppos = pV0vectorlm.Dot(vPos) / pV0mag;
        double Pneg = pV0vectorlm.Dot(vNeg) / pV0mag;
        double denom = (Ppos + Pneg);
        double qt_lm = (vPos.Cross(vNeg)).Mag() / pV0mag;
        double alpha_lm = (Ppos - Pneg) / denom;

	
        if(V0mass_lm > 1.106 && V0mass_lm < 1.122  &&(V0pt_lm > 2.0)){
          harmen_wocut_lm_ ->Fill(alpha_lm, qt_lm);
	}

	v0masspipi = sqrt((sqrt(0.13957*0.13957+pd1_lm*pd1_lm)+sqrt(0.13957*0.13957+pd2_lm*pd2_lm))*(sqrt(0.13957*0.13957+pd1_lm*pd1_lm)+sqrt(0.13957*0.13957+pd2_lm*pd2_lm))-dauvecsum_lm.Mag2());
        v0massee = sqrt((sqrt(0.000511*0.000511+pd1_lm*pd1_lm)+sqrt(0.000511*0.000511+pd2_lm*pd2_lm))*(sqrt(0.000511*0.000511+pd1_lm*pd1_lm)+sqrt(0.000511*0.000511+pd2_lm*pd2_lm))-dauvecsum_lm.Mag2());

        //std::cout << "v0masspipi(before cut) : " << v0masspipi << "   " << "v0massee(befor cut) : " << v0massee << "  " << "mis_ks_range_(before cut) : " << mis_ks_range_ << std::endl;
	

        if((v0masspipi >= (0.497614-mis_ks_range_) && v0masspipi <= (0.497614+mis_ks_range_)) || v0massee <= mis_ph_range_ ) continue;

        hV0pT_before_lm_->Fill(V0pt_lm);

        //std::cout << "qt_lm(after cuts): " << qt_lm << "   " << "alpha_lm(after cuts): " << alpha_lm << std::endl;  

	if ( V0pt_lm > pTmax_ || V0pt_lm < pTmin_ ) continue;
	if ( V0rapidity_lm > Rapmax_ || V0rapidity_lm < Rapmin_ ) continue;
	//if ( V0eta_lm > Etamax_ || V0eta_lm < Etamin_ ) continue;
	if ( V0mass_lm > Massmax_lm_ || V0mass_lm < Massmin_lm_ ) continue;
	if (V0vtxDecaySigXYZ_lm < DecaySigXYZmin_) continue;
        if (V0cosThetaXYZ_lm < ThetaXYZmin_) continue;     //bismita

	//std::cout << "pNhit & nNhit:" << pTrkNHit_lm << " " << nTrkNHit_lm << std::endl;

	//Define lambda efficiency weight
	double w_lm = 1.;
        double eff_lm = (hEff_3D_lm->GetBinContent(hEff_3D_lm->GetXaxis()->FindBin(V0pt_lm),hEff_3D_lm->GetYaxis()->FindBin(V0eta_lm), hEff_3D_lm->GetZaxis()->FindBin(centbin)));
	
	if(eff_lm > 0.){                                                                                                                                                                              
          w_lm = 1./(eff_lm);                                                                                                                                                                        
        }else{
          w_lm = 1.;                                                                                                                                                                                  
        }

	//std::cout << "w_lm : " << w_lm << "   " <<"pT :" << V0pt_lm << "    " << " rapidity: " << V0rapidity_lm << "  " << "cent :" << centbin << std::endl;
	
	int ipt = hV0pTbin_lm->FindBin(V0pt_lm) - 1;
	lambda_pT[icent][ipt]->Fill(V0mass_lm, w_lm);

	if(V0mass_lm > 1.106 && V0mass_lm < 1.122  &&(V0pt_lm > 2.0)){
          harmen_wcut_lm_ ->Fill(alpha_lm, qt_lm);
        }
	
	hV0mass_wocut_lm_->Fill(V0mass_lm);
	hV0pT_lm_->Fill(V0pt_lm);
	hV0phi_lm_->Fill(V0phi_lm);
	hV0eta_lm_->Fill(V0eta_lm);
	hchi2_lm_->Fill(V0Chi2_lm);

	int index1_lm = GetpTbin(V0pt_lm, is_dcut);
        if(index1_lm == -1) continue;

	if ( V0mass_lm > 1.08 && V0mass_lm < 1.16 ) //cuts obtained from Raghu's PbPb paper
	  {
	    AssignpTbins(V0pt_lm, V0eta_lm, V0phi_lm, V0id_lm, V0mass_lm, w_lm, pdau_pt_lm, pdau_eta_lm, pdau_phi_lm, ndau_pt_lm, ndau_eta_lm, ndau_phi_lm, index1_lm, is_dcut);
	    nevent_lm++;
	    //nevent_lm[icent]++;
	  }
      }

    //~~~~~~~~~~~~~~~~~~~~~~~~~~~ charged hadron ~~~~~~~~~~~~~~~~~~~~~~~
    ntrkoff = 0;
    for (size_t itrk = 0; itrk < packed->size(); ++itrk) {
      const pat::PackedCandidate& cand_ch = (*packed)[itrk];

     if (!cand_ch.hasTrackDetails()) continue;
     if (cand_ch.charge() == 0) continue;

     edm::Ref<pat::PackedCandidateCollection> candRef(packed, itrk);
     const reco::Track* trk_ch = (*pc2track)[candRef].get();
     if (!trk_ch) continue;
     math::XYZPoint bestvtx(pv->x(), pv->y(), pv->z());

     double xVtxError_ch = pv->xError();
     double yVtxError_ch = pv->yError();
     double zVtxError_ch = pv->zError();

     double dzvtx_ch = trk_ch->dz(bestvtx);
     double dxyvtx_ch = trk_ch->dxy(bestvtx);
     double dzerror_ch = std::sqrt(std::pow(trk_ch->dzError(), 2) + std::pow(zVtxError_ch, 2));
     double dxyerror_ch = std::sqrt(std::pow(trk_ch->d0Error(), 2) + std::pow(xVtxError_ch, 2) + std::pow(yVtxError_ch, 2));
     double pterror_ch = trk_ch->ptError();

      // Get eta, pt, phi and charge of the track                                                                                                                                                    
      double pt = trk_ch->pt();
      double eta = trk_ch->eta();
      double phi = trk_ch->phi();
      int charge = trk_ch->charge();
      bool is_dcut = kTRUE;

       if( !trk_ch->quality(reco::TrackBase::highPurity) ) continue;
      if( charge == 0 ) continue;
      if( std::abs(pterror_ch) / pt >= 0.1 ) continue;
      if( std::abs(dzvtx_ch / dzerror_ch) >= 3.0 ) continue;
      if( std::abs(dxyvtx_ch / dxyerror_ch) >= 3.0  ) continue;
      if( pt <= 0.4 ) continue;
      ntrkoff++;
    }
    
    for (size_t jtrk = 0; jtrk < packed->size(); ++jtrk) {
      const pat::PackedCandidate& cand_ch = (*packed)[jtrk];

     if (!cand_ch.hasTrackDetails()) continue;
     if (cand_ch.charge() == 0) continue;
     
     edm::Ref<pat::PackedCandidateCollection> candRef(packed, jtrk);
     const reco::Track* trk_ch = (*pc2track)[candRef].get();
     if (!trk_ch) continue;
     math::XYZPoint bestvtx(pv->x(), pv->y(), pv->z());

     double xVtxError_ch = pv->xError();
     double yVtxError_ch = pv->yError();
     double zVtxError_ch = pv->zError();
	
     double dzvtx_ch = trk_ch->dz(bestvtx);
     double dxyvtx_ch = trk_ch->dxy(bestvtx);
     double dzerror_ch = std::sqrt(std::pow(trk_ch->dzError(), 2) + std::pow(zVtxError_ch, 2));
     double dxyerror_ch = std::sqrt(std::pow(trk_ch->d0Error(), 2) + std::pow(xVtxError_ch, 2) + std::pow(yVtxError_ch, 2));
     double pterror_ch = trk_ch->ptError();

      // Get eta, pt, phi and charge of the track
      double pt = trk_ch->pt();
      double eta = trk_ch->eta();
      double phi = trk_ch->phi();
      int charge = trk_ch->charge();
      bool is_dcut = kTRUE;

      //selected tracks
      if( !trk_ch->quality(reco::TrackBase::highPurity) ) continue;
      if( charge == 0 ) continue;
      if( std::abs(pterror_ch) / pt >= 0.1 ) continue;
      if( std::abs(dzvtx_ch / dzerror_ch) >= 3.0 ) continue;
      if( std::abs(dxyvtx_ch / dxyerror_ch) >= 3.0  ) continue;

      if( pt <= pTmin_ch_ || pt > pTmax_ch_ ) continue;
      if( eta <= Etamin_ || eta >= Etamax_ ) continue;
      
      int id=0;
      if(charge > 0) id = 1;
      else id = -1;

      int index_ch = GetpTbin(pt, is_dcut);
      if(index_ch == -1) continue;

      double massall = 0.139570;

      //Define efficiency of charged hadrons                                                                                                                                                
      double w_ch = 1.;
      
      double eff = hEff_3D->GetBinContent(hEff_3D->GetXaxis()->FindBin(eta), hEff_3D->GetYaxis()->FindBin(pt), hEff_3D->GetZaxis()->FindBin(centbin));
      double fake = hFak3D->GetBinContent(hFak3D->GetXaxis()->FindBin(eta), hFak3D->GetYaxis()->FindBin(pt), hFak3D->GetZaxis()->FindBin(centbin)) ;
      double sec = hSec_3D->GetBinContent(hSec_3D->GetXaxis()->FindBin(eta), hSec_3D->GetYaxis()->FindBin(pt), hSec_3D->GetZaxis()->FindBin(centbin));
      double mult = hMul_3D->GetBinContent(hMul_3D->GetXaxis()->FindBin(eta), hMul_3D->GetYaxis()->FindBin(pt), hMul_3D->GetZaxis()->FindBin(centbin));

      if(eff > 0.001)                                                                                                                                                                       
        {
          w_ch = (1 - fake)*(1 - sec)/eff/(1 + mult) ;                                                                                                                                    
        }
      else
        {
          w_ch = 1 ;                                                                                                                                                                         
        }
      if((pt < 0 || pt > 500) || (fabs(eta) > 2.4))                                                                                                                                         
        w_ch = 0 ; 
      
      AssignpTbins(pt, eta, phi, id, massall, w_ch, pt, eta, phi, pt, eta, phi, index_ch, is_dcut);
      
    }
  
    V0pt_vect.clear();
    V0eta_vect.clear();
    V0phi_vect.clear();
    V0id_vect.clear();
    V0mass_vect.clear();
    
    pdau_pt_vect.clear();
    pdau_eta_vect.clear();
    pdau_phi_vect.clear();
    pdau_chi2_vect.clear();
    
    ndau_pt_vect.clear();
    ndau_eta_vect.clear();
    ndau_phi_vect.clear();
    ndau_chi2_vect.clear();
    
}



//======================================================================
int RaghuV0Ana::GetpTbin(double V0pt, bool is_dcut)
{
  int idx = -1;
  is_dcut = kTRUE;
  
  for(unsigned int trgidx = 0; trgidx < pTmin_trg_.size(); ++trgidx)
    
    {
      if(V0pt >= pTmin_trg_[trgidx] && V0pt <= pTmax_trg_[trgidx]){
	idx = trgidx;
      }
    }
    
  for(unsigned int assidx = 0; assidx < pTmin_ass_.size(); ++assidx)
    
    {
      if(V0pt >= pTmin_ass_[assidx] && V0pt <= pTmax_ass_[assidx]){
	idx = assidx;
      }
    }

  return idx;
}
//===========================================================================================================================================
void
RaghuV0Ana::AssignpTbins(double V0pt, double V0eta, double V0phi,int V0id, double v0mass, double v0eff, double pdau_pt, double pdau_eta, double pdau_phi, double ndau_pt, double ndau_eta, double ndau_phi, int idx, bool is_dcut)
  
  
{

  TVector3 pvector;                    
  // pvector.SetPtEtaPhiM(V0pt, V0eta, V0phi, V0mass);
  pvector.SetPtEtaPhi(V0pt, V0eta, V0phi);
  TVector3 pvector_pdau;
  // pvector_pdau.SetPtEtaPhiM(pdau_pt, pdau_eta, pdau_phi, 0.139570 );
  pvector_pdau.SetPtEtaPhi(pdau_pt, pdau_eta, pdau_phi);
  TVector3 pvector_ndau;
  // pvector_ndau.SetPtEtaPhiM(ndau_pt, ndau_eta, ndau_phi, 0.139570 );
  pvector_ndau.SetPtEtaPhi(ndau_pt, ndau_eta, ndau_phi);

  
  if(is_dcut)
    {
      (evt_->pVect_trg[idx]).push_back(pvector);
      (evt_->chgVect_trg[idx]).push_back(V0id);
      (evt_->massVect_trg[idx]).push_back(v0mass);
      (evt_->weightVect_all[idx]).push_back(v0eff);
      (evt_->pVect_daup_trg[idx]).push_back(pvector_pdau);
      (evt_->pVect_daun_trg[idx]).push_back(pvector_ndau);

    }

   
}

