//===============================================================================================================================
void
RaghuV0Ana::FillHistsSignal_match_unmatch(int ievt)
{
  for( unsigned int itrg = 0; itrg < pTmin_trg_.size(); itrg++ )
    {
      for( unsigned int jass = 0; jass < pTmin_ass_.size(); jass++ )
	{
	  if( itrg < jass )
	    {
	      std::cout<<"itrg < jass"<<std::endl;
	      continue;
	    }

	  unsigned int ntrgsize = evtVec_[ievt].pVect_trg[itrg].size();
	  unsigned int nasssize = evtVec_[ievt].pVect_ass[itrg].size();

	  // std::cout << "error21" << std::endl;
	  for( unsigned int ntrg = 0; ntrg < ntrgsize; ntrg++ )
	    {
	      TLorentzVector pvector_trg = (evtVec_[ievt].pVect_trg[itrg])[ntrg];
	      double px_trg = pvector_trg.Px();
	      double py_trg = pvector_trg.Py();
	      double pz_trg = pvector_trg.Pz();
	      double V0mass_trg = pvector_trg.M();
	      double E_trg = pvector_trg.E();
	      int V0id_trg = (evtVec_[ievt].chgVect_trg[itrg])[ntrg];

	      TLorentzVector pvector_daup_trg = (evtVec_[ievt].pVect_daup_trg[itrg])[ntrg];
	      TLorentzVector pvector_daun_trg = (evtVec_[ievt].pVect_daun_trg[itrg])[ntrg];
	      
  	      double eta_daup_trg = pvector_daup_trg.Eta();
  	      double phi_daup_trg = pvector_daup_trg.Phi();
              	      
	      double eta_daun_trg = pvector_daun_trg.Eta();
  	      double phi_daun_trg = pvector_daun_trg.Phi();
              	      
	      for( unsigned int nass = 0 ; nass < nasssize; nass++ )
		
		{
		  TLorentzVector pvector_ass = (evtVec_[ievt].pVect_ass[jass])[nass];
		  double px_ass = pvector_ass.Px();
		  double py_ass = pvector_ass.Py();
		  double pz_ass = pvector_ass.Pz();
		  double V0mass_ass = pvector_ass.M();
		  double E_ass = pvector_ass.E();
		  int V0id_ass = (evtVec_[ievt].chgVect_ass[jass])[nass];
		  		  
		  TLorentzVector pvector_daup_ass = (evtVec_[ievt].pVect_daup_ass[jass])[nass];
		  TLorentzVector pvector_daun_ass = (evtVec_[ievt].pVect_daun_ass[jass])[nass];
		  
		  double eta_daup_ass = pvector_daup_ass.Eta();
		  double phi_daup_ass = pvector_daup_ass.Phi();
		  
		  double eta_daun_ass = pvector_daun_ass.Eta();
		  double phi_daun_ass = pvector_daun_ass.Phi();
		  		  
		  if (px_trg == px_ass && py_trg == py_ass && pz_trg == pz_ass && V0mass_trg == V0mass_ass) continue;

		  if ((V0mass_trg < 1.1115 || V0mass_trg >1.12) && (V0mass_ass < 1.1115 || V0mass_ass> 1.12)) continue;

		  if( (V0id_trg == 3122 && V0id_ass == -3122) ||  (V0id_trg == -3122 && V0id_ass == 3122)) continue;
		  
                  double Q_inv = GetQInv(px_ass,py_ass,pz_ass,E_ass,px_trg,py_trg,pz_trg,E_trg);
                  
		  hV0mass_sig_before_match_unmatch->Fill(Q_inv);
                  		  
		  if ((fabs(eta_daup_trg-eta_daup_ass) == dau_etaphi_ && fabs(phi_daup_trg-phi_daup_ass) == dau_etaphi_) || (fabs(eta_daun_trg-eta_daun_ass) == dau_etaphi_ && fabs(phi_daun_trg-phi_daun_ass)== dau_etaphi_))
		    {
		      		      
		      double Q_inv_bais = GetQInvbais(px_ass,py_ass,pz_ass,E_ass,px_trg,py_trg,pz_trg,E_trg);
		      hV0mass_sig_bais_match_unmatch->Fill(Q_inv_bais);
		      continue;
		    }
                  else
                    {
		      double Q_inv1 = GetQInv(px_ass,py_ass,pz_ass,E_ass,px_trg,py_trg,pz_trg,E_trg);
		      hV0mass_sig_after_match_unmatch->Fill(Q_inv1);
		    }
		}
	    }
	}
    }
}
//==========================================================================================================================================
void
RaghuV0Ana::FillHistsSignal_unmatch(int ievt)
{
  for( unsigned int itrg = 0; itrg < pTmin_trg_.size(); itrg++ )
    {
      for( unsigned int jass = itrg + 1; jass < pTmin_ass_.size(); jass++ )
	{
	  if( itrg < jass )
	    {
	      std::cout<<"itrg < jass"<<std::endl;
	      continue;
	    }

	  unsigned int nasssize = evtVec_[ievt].pVect_ass[itrg].size();

	  //std::cout << "error22" << std::endl;
	  for( unsigned int ntrg = 0; ntrg < nasssize; ntrg++ )
	    {
	      TLorentzVector pvector_trg = (evtVec_[ievt].pVect_ass[itrg])[ntrg];
	      double px_trg = pvector_trg.Px();
	      double py_trg = pvector_trg.Py();
	      double pz_trg = pvector_trg.Pz();
	      double V0mass_trg = pvector_trg.M();
	      double E_trg = pvector_trg.E();
	      int V0id_trg = (evtVec_[ievt].chgVect_ass[itrg])[ntrg];

	      TLorentzVector pvector_daup_trg = (evtVec_[ievt].pVect_daup_ass[itrg])[ntrg];
	      TLorentzVector pvector_daun_trg = (evtVec_[ievt].pVect_daun_ass[itrg])[ntrg];
	      
  	      double eta_daup_trg = pvector_daup_trg.Eta();
  	      double phi_daup_trg = pvector_daup_trg.Phi();
              	      
	      double eta_daun_trg = pvector_daun_trg.Eta();
  	      double phi_daun_trg = pvector_daun_trg.Phi();
              	      
	      for( unsigned int nass = ntrg+1 ; nass < nasssize; nass++ ) 
		
		{
		  TLorentzVector pvector_ass = (evtVec_[ievt].pVect_ass[jass])[nass];
		  double px_ass = pvector_ass.Px();
		  double py_ass = pvector_ass.Py();
		  double pz_ass = pvector_ass.Pz();
		  double V0mass_ass = pvector_ass.M();
		  double E_ass = pvector_ass.E();
		  int V0id_ass = (evtVec_[ievt].chgVect_ass[jass])[nass];
		  		  
		  TLorentzVector pvector_daup_ass = (evtVec_[ievt].pVect_daup_ass[jass])[nass];
		  TLorentzVector pvector_daun_ass = (evtVec_[ievt].pVect_daun_ass[jass])[nass];
		  
		  double eta_daup_ass = pvector_daup_ass.Eta();
		  double phi_daup_ass = pvector_daup_ass.Phi();
		  
		  double eta_daun_ass = pvector_daun_ass.Eta();
		  double phi_daun_ass = pvector_daun_ass.Phi();
		  		  
		  if (px_trg == px_ass && py_trg == py_ass && pz_trg == pz_ass && V0mass_trg == V0mass_ass) continue;

		  if ((V0mass_trg < 1.1115 || V0mass_trg >1.12) && (V0mass_ass < 1.1115 || V0mass_ass> 1.12)) continue;

		  if( (V0id_trg == 3122 && V0id_ass == -3122) ||  (V0id_trg == -3122 && V0id_ass == 3122)) continue;
		  
                  double Q_inv = GetQInv(px_ass,py_ass,pz_ass,E_ass,px_trg,py_trg,pz_trg,E_trg);
                  
		  hV0mass_sig_before_unmatch->Fill(Q_inv);
                  		  
		  if ((fabs(eta_daup_trg-eta_daup_ass) == dau_etaphi_ && fabs(phi_daup_trg-phi_daup_ass) == dau_etaphi_) || (fabs(eta_daun_trg-eta_daun_ass) == dau_etaphi_ && fabs(phi_daun_trg-phi_daun_ass)== dau_etaphi_))
		    {
		      		      
		      double Q_inv_bais = GetQInvbais(px_ass,py_ass,pz_ass,E_ass,px_trg,py_trg,pz_trg,E_trg);
		      hV0mass_sig_bais_unmatch->Fill(Q_inv_bais);
		      continue;
		    }
                  else
                    {
		      double Q_inv1 = GetQInv(px_ass,py_ass,pz_ass,E_ass,px_trg,py_trg,pz_trg,E_trg);
		      hV0mass_sig_after_unmatch->Fill(Q_inv1);
		    }
		}
	    }
	}
    }
}
//==========================================================================================================================================
void
RaghuV0Ana::FillHistsBackground(int ievt_trg, int jevt_ass)
{
  if( evtVec_[ievt_trg].run ==  evtVec_[jevt_ass].run &&
      evtVec_[ievt_trg].event == evtVec_[jevt_ass].event )
    {
      std::cout << "Event are the same. Skipping it" << std::endl;
      return;
    }

  // std::cout << "error23" << std::endl;
  for( unsigned int itrg = 0; itrg < pTmin_trg_.size(); itrg++ )
    {
      for( unsigned int jass = itrg + 1; jass < pTmin_ass_.size(); jass++ )
        {
          if( itrg < jass ) continue;
	  
          unsigned int ntrgsize = evtVec_[ievt_trg].pVect_trg[itrg].size();
          unsigned int nasssize = evtVec_[jevt_ass].pVect_ass[jass].size();

	  for( unsigned int ntrg = 0; ntrg < ntrgsize; ntrg++ )
	    {
	      TLorentzVector& pvector_trg = (evtVec_[ievt_trg].pVect_trg[itrg])[ntrg];
